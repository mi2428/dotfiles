SAKURA_AI_ACCOUNT_TOKEN=XXXXXXXXXX
SAKURA_AI_MODEL=gpt-oss-120b
WEBUI_SECRET_KEY=XXXXXXXXXX

# Used to create the first admin in both Computer and Open WebUI.
CPTR_ADMIN_USERNAME=admin
CPTR_ADMIN_PASSWORD=changeme
WEBUI_ADMIN_EMAIL=admin@localhost

# Replace this after creating a key in cptr: Settings > Admin > Gateway.
CPTR_GATEWAY_API_KEY=bootstrap

# cptr can access only this host directory.
CPTR_WORKSPACE_DIR=/tmp

OPEN_WEBUI_PORT=8080
CPTR_PORT=8000
