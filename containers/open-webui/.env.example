# Copy to .env, then replace every value marked "replace-me".
# Full account token: <UUID>:<secret>
SAKURA_AI_ACCOUNT_TOKEN=replace-me
SAKURA_AI_MODEL=gpt-oss-120b
WEBUI_SECRET_KEY=replace-me

# Created automatically on the first Computer startup.
CPTR_ADMIN_USERNAME=replace-me
CPTR_ADMIN_PASSWORD=replace-me

# Replace this after creating a key in cptr: Settings > Admin > Gateway.
CPTR_GATEWAY_API_KEY=bootstrap

# cptr can access only this host directory.
CPTR_WORKSPACE_DIR=replace-me

OPEN_WEBUI_PORT=8080
CPTR_PORT=8000
