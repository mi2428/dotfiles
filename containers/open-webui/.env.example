# Sakura AI Engine account token issued in the control panel:
# https://manual.sakura.ad.jp/cloud/ai-engine/02-howto.html
SAKURA_AI_ACCOUNT_TOKEN=XXXXXXXXXX

# Random application secret. Generate one with: openssl rand -hex 32
WEBUI_SECRET_KEY=XXXXXXXXXX

# Shared admin account. Open WebUI uses the email; Computer uses the username.
WEBUI_ADMIN_USERNAME=XXXXXXXXXX
WEBUI_ADMIN_EMAIL=XXXXXXXXXX
WEBUI_ADMIN_PASSWORD=XXXXXXXXXX

# Replaced automatically with a Computer Gateway API key on first startup.
CPTR_GATEWAY_API_KEY=bootstrap

# Absolute host directory that Computer may access.
CPTR_WORKSPACE_DIR=/tmp

# Host port for Open WebUI.
OPEN_WEBUI_PORT=8080
