diff --git a/packages/tui/src/component/prompt/router-model.ts b/packages/tui/src/component/prompt/router-model.ts
new file mode 100644
index 0000000..dfbbfe1
--- /dev/null
+++ b/packages/tui/src/component/prompt/router-model.ts
@@ -0,0 +1,17 @@
+export function routerLabel(
+  model: { providerID: string; modelID: string; variant?: string } | undefined,
+  parts: readonly { type: string; metadata?: Record<string, unknown> }[] | undefined,
+) {
+  if (!model) return
+  const marker = parts?.find((part) => part.type === "text" && part.metadata?.modelRouter)?.metadata?.modelRouter
+  if (!marker || typeof marker !== "object" || !("model" in marker)) return
+  const selected = marker.model
+  if (!selected || typeof selected !== "object" || !("providerID" in selected) || !("modelID" in selected)) return
+  if (
+    selected.providerID !== model.providerID ||
+    selected.modelID !== model.modelID ||
+    ("variant" in selected ? selected.variant : undefined) !== model.variant
+  )
+    return
+  return "label" in marker && typeof marker.label === "string" ? marker.label : "Smart Router"
+}
diff --git a/packages/tui/test/cli/tui/router-model.test.ts b/packages/tui/test/cli/tui/router-model.test.ts
new file mode 100644
index 0000000..78f3566
--- /dev/null
+++ b/packages/tui/test/cli/tui/router-model.test.ts
@@ -0,0 +1,17 @@
+import { expect, test } from "bun:test"
+import { routerLabel } from "../../../src/component/prompt/router-model"
+
+const model = { providerID: "sakura", modelID: "preview/Kimi-K2.7-Code", variant: "auto" }
+const routed = [{ type: "text", metadata: { modelRouter: { model, label: "Smart Router · SIMPLE · confidence 0.8" } } }]
+
+test("recognizes a routed user turn and keeps its compact label", () => {
+  expect(routerLabel(model, routed)).toBe("Smart Router · SIMPLE · confidence 0.8")
+  expect(routerLabel(model, [{ type: "text", metadata: { modelRouter: { model } } }])).toBe("Smart Router")
+})
+
+test("never treats a different or manual model as auto-routed", () => {
+  expect(routerLabel({ ...model, variant: "high" }, routed)).toBeUndefined()
+  expect(routerLabel({ ...model, modelID: "preview/Kimi-K2.6" }, routed)).toBeUndefined()
+  expect(routerLabel(model, [{ type: "text" }])).toBeUndefined()
+  expect(routerLabel(model, undefined)).toBeUndefined()
+})
