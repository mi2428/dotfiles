#!/bin/sh
set -eu

config=${OPENCODE_ROUTER_CONFIG:-"${HOME:?}/.config/opencode-profiles/router/opencode/model-router.json"}
state_dir=${XDG_STATE_HOME:-"${HOME:?}/.local/state"}/ollaya

fallback() {
	reason=$1
	model=$(jq -er '.fallback | .providerID + "/" + .modelID' "$config") || return 1
	variant=$(jq -er '.fallback.variant' "$config") || return 1
	jq -cn --arg model "$model" --arg variant "$variant" --arg reason "$reason" \
		'{tier:null,confidence:null,model:$model,variant:$variant,fallback:true,reason:$reason}'
}

ready() {
	command -v ollaya >/dev/null 2>&1 || {
		printf '%s\n' 'ai-model-route: ollaya is not installed' >&2
		return 1
	}
	command -v curl >/dev/null 2>&1 || {
		printf '%s\n' 'ai-model-route: curl is not installed' >&2
		return 1
	}
	command -v jq >/dev/null 2>&1 || {
		printf '%s\n' 'ai-model-route: jq is not installed' >&2
		return 1
	}
	[ -f "$config" ] || {
		printf 'ai-model-route: config is missing: %s\n' "$config" >&2
		return 1
	}
	version_endpoint=$(jq -er '.endpoint' "$config")
	version_endpoint=${version_endpoint%/*}/version

	if ! curl -fsS --max-time 1 "$version_endpoint" >/dev/null 2>&1; then
		mkdir -p "$state_dir"
		nohup ollaya serve >"$state_dir/serve.log" 2>&1 &
		printf '%s\n' "$!" >"$state_dir/serve.pid"
		attempts=0
		while ! curl -fsS --max-time 1 "$version_endpoint" >/dev/null 2>&1; do
			attempts=$((attempts + 1))
			[ "$attempts" -lt 30 ] || {
				printf '%s\n' 'ai-model-route: ollaya did not become ready' >&2
				return 1
			}
			sleep 1
		done
	fi

	model=$(jq -er '.model' "$config")
	ollaya show "$model" >/dev/null 2>&1 || {
		printf 'ai-model-route: model is missing; run: ollaya pull %s\n' "$model" >&2
		return 1
	}
}

if [ "${1:-}" = --ready ]; then
	ready
	exit
fi

if [ "$#" -gt 0 ]; then
	state=$*
elif [ ! -t 0 ]; then
	state=$(cat)
else
	printf '%s\n' 'usage: ai-model-route "assignment"' >&2
	exit 64
fi

if jq -ne --arg state "$state" '$state | test("(^|[^A-Za-z0-9_])router:max([^A-Za-z0-9_]|$)"; "i")' >/dev/null 2>&1; then
	[ -f "$config" ] || { printf 'ai-model-route: config is missing: %s\n' "$config" >&2; exit 1; }
	selected=$(jq -er '.tiers.REASONING | .providerID + "/" + .modelID' "$config")
	variant=$(jq -er '.tiers.REASONING.variant' "$config")
	jq -cn --arg model "$selected" --arg variant "$variant" \
		'{tier:"REASONING",confidence:null,model:$model,variant:$variant,fallback:false,reason:"explicit_router_max"}'
	exit
fi

if ! ready; then
	fallback classifier_unavailable
	exit
fi

model=$(jq -er '.model' "$config")
endpoint=$(jq -er '.endpoint' "$config")
keep_alive=$(jq -er '.keep_alive' "$config")
timeout=$(jq -er '.timeout_ms / 1000' "$config")
questions=$(jq -c '.questions' "$config")

set -- -fsS --max-time "$timeout" -H 'Content-Type: application/json'
if [ -n "${OLLAYA_API_KEY:-}" ]; then
	set -- "$@" -H "Authorization: Bearer $OLLAYA_API_KEY"
fi

if ! response=$(jq -cn \
	--arg model "$model" \
	--arg state "$state" \
	--arg keep_alive "$keep_alive" \
	--argjson questions "$questions" \
	'{model:$model,state:$state,questions:$questions,keep_alive:$keep_alive}' |
	curl "$@" --data-binary @- "$endpoint"); then
	fallback classifier_unavailable
	exit
fi

tier=$(printf '%s\n' "$response" | jq -er '.answers.tier.choice' 2>/dev/null || true)
confidence=$(printf '%s\n' "$response" | jq -er '.answers.tier.confidence | numbers' 2>/dev/null || true)
clarity=$(printf '%s\n' "$response" | jq -er '.answers.clarity.choice' 2>/dev/null || true)
context_confidence=$(printf '%s\n' "$response" | jq -er '.answers.clarity.confidence | numbers' 2>/dev/null || true)
minimum=$(jq -er '.min_confidence' "$config")
context_minimum=$(jq -er '.min_context_confidence' "$config")

if [ -z "$context_confidence" ] || { [ "$clarity" != CLEAR ] && [ "$clarity" != CONTEXT_REQUIRED ]; } ||
	! jq -en --argjson value "$context_confidence" '$value >= 0 and $value <= 1' >/dev/null; then
	fallback invalid_context
	exit
fi

if [ -z "$tier" ] || [ -z "$confidence" ] ||
	! jq -en --argjson confidence "$confidence" --argjson minimum "$minimum" '$confidence >= $minimum and $confidence <= 1' >/dev/null; then
	fallback low_confidence
	exit
fi

if [ "$clarity" != CLEAR ] ||
	! jq -en --argjson confidence "$context_confidence" --argjson minimum "$context_minimum" '$confidence >= $minimum' >/dev/null; then
	fallback context_missing
	exit
fi

if [ "$tier" = DEFAULT ]; then
	fallback not_simple
	exit
fi
[ "$tier" = SIMPLE ] || { fallback invalid_tier; exit; }

selected=$(jq -er --arg tier "$tier" '.tiers[$tier] | .providerID + "/" + .modelID' "$config" 2>/dev/null || true)
variant=$(jq -er --arg tier "$tier" '.tiers[$tier].variant' "$config" 2>/dev/null || true)
if [ -z "$selected" ] || [ -z "$variant" ]; then
	fallback invalid_tier
	exit
fi

jq -cn \
	--arg tier "$tier" \
	--argjson confidence "$confidence" \
	--arg model "$selected" \
	--arg variant "$variant" \
	'{tier:$tier,confidence:$confidence,model:$model,variant:$variant,fallback:false,reason:null}'
