+    fn submit_native_agent_prompt(
+        &mut self,
+        validated: ValidatedAgentPrompt,
+        params: &AgentPromptParams,
+        respond_to: std::sync::mpsc::Sender<String>,
+    ) -> Result<(), String> {
+        let ValidatedAgentPrompt { id, agent, .. } = validated;
+        let Some(delivery) = self.agent_deliveries.get_mut(&agent.pane_id) else {
+            return Err(encode_error(
+                id,
+                "agent_delivery_unavailable",
+                "frontend is unavailable",
+            ));
+        };
+        if delivery.last_poll.elapsed() > DELIVERY_LEASE
+            || agent.agent_session.as_ref().is_none_or(|session| {
+                session.source != "herdr:opencode" || session.value != delivery.root_id
+            })
+        {
+            return Err(encode_error(
+                id,
+                "agent_delivery_unavailable",
+                "frontend root is unavailable",
+            ));
+        }
+        delivery.clear_expired();
+        if delivery.pending.is_some() {
+            return Err(encode_error(
+                id,
+                "agent_delivery_busy",
+                "frontend already has a pending delivery",
+            ));
+        }
+        let (tx, rx) = std::sync::mpsc::channel::<std::io::Result<()>>();
+        let waiter_id = id.clone();
+        let waiter_agent = agent.clone();
+        crate::thread_spawn::spawn_named("herdr-agent-delivery", move || {
+            let response = match rx.recv_timeout(DELIVERY_TIMEOUT) {
+                Ok(Ok(())) => encode_success(
+                    waiter_id,
+                    ResponseResult::AgentPrompted {
+                        agent: waiter_agent,
+                    },
+                ),
+                Ok(Err(err)) => encode_error(waiter_id, "agent_delivery_rejected", err.to_string()),
+                Err(_) => encode_error(
+                    waiter_id,
+                    "agent_delivery_unavailable",
+                    "frontend did not confirm delivery; do not retry without checking the session",
+                ),
+            };
+            let _ = respond_to.send(response);
+        })
+        .map_err(|err| encode_error(id.clone(), "agent_delivery_unavailable", err.to_string()))?;
+        delivery.pending = Some(PendingDelivery {
+            id,
+            text: params.text.clone(),
+            delivered: false,
+            started: Instant::now(),
+            completion: tx,
+        });
+        Ok(())
+    }
