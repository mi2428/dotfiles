@@ -0,0 +1,126 @@
+import { test, expect, mock } from "bun:test";
+import { EventEmitter } from "node:events";
+
+let reply: ((result: unknown) => void) | undefined;
+const sent: Array<{ method: string; params: Record<string, unknown> }> = [];
+const sessionInfo = (id: string) => ({
+  id, projectID: "project", cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+  time: { created: 1, updated: 1 }, location: { directory: "/project" },
+});
+mock.module("@opencode/plugin/tui", () => ({ Plugin: { define: (value: unknown) => value } }));
+mock.module("../herdr-tui-session.js", () => ({ default: { setup: () => () => {} } }));
+mock.module("node:net", () => ({ default: { createConnection: () => {
+  const socket = new EventEmitter() as EventEmitter & { write: (text: string) => void; destroy: () => void };
+  socket.write = (text) => {
+    const request = JSON.parse(text);
+    sent.push(request);
+    reply = (result) => socket.emit("data", Buffer.from(JSON.stringify({ id: request.id, result }) + "\n"));
+  };
+  socket.destroy = () => socket.emit("close");
+  queueMicrotask(() => socket.emit("connect"));
+  return socket;
+} } }));
+
+test("V2 delivery rejects A-B-A stale work and sends one explicit root prompt", async () => {
+  process.env.HERDR_ENV = "1";
+  process.env.HERDR_PANE_ID = "w1:p1";
+  process.env.HERDR_SOCKET_PATH = "/unused/test.sock";
+  process.env.HERDR_OPENCODE_ROOT_ID = "a";
+  const { default: plugin } = await import("./tui.js");
+  let sessionID = "a";
+  const prompts: unknown[] = [];
+  const stop = await plugin.setup({
+    ui: { router: { current: () => ({ type: "session", sessionID }) } },
+    data: { session: { root: (id: string) => id === "child" ? "a" : id } },
+    client: { session: { prompt: async (params: unknown) => { prompts.push(params); return { id: "accepted", sessionID: "a", time: { created: 1 }, type: "user", payload: { text: "right" }, delivery: "queue" }; } } },
+  });
+  try {
+    await Bun.sleep(30);
+    expect(sent[0]?.method).toBe("agent.delivery.poll");
+    sessionID = "b";
+    await Bun.sleep(40);
+    sessionID = "a";
+    await Bun.sleep(40);
+    reply?.({ type: "agent_delivery", delivery_id: "stale", text: "wrong" });
+    await Bun.sleep(130);
+    expect(prompts).toEqual([]);
+    sessionID = "child";
+    await Bun.sleep(40);
+    reply?.({ type: "agent_delivery", delivery_id: "new", text: "right" });
+    await Bun.sleep(40);
+    expect(prompts).toEqual([{ sessionID: "a", text: "right" }]);
+    expect(sent.some((item) => item.method === "agent.delivery.complete" && item.params.delivery_id === "new" && item.params.accepted === true)).toBe(true);
+  } finally { stop?.(); }
+});
+
+test("a home worker creates and navigates to a fresh root before registering", async () => {
+  delete process.env.HERDR_OPENCODE_ROOT_ID;
+  const { default: plugin } = await import("./tui.js");
+  let route: { type: string; sessionID?: string } = { type: "home" };
+  let created = 0;
+  const stop = await plugin.setup({
+    ui: { router: {
+      current: () => route,
+      navigate: (value: typeof route) => { route = value; },
+    } },
+    data: { session: { root: (id: string) => id } },
+    client: { session: { create: async () => { created++; return sessionInfo("fresh"); } } },
+  });
+  try {
+    expect(created).toBe(1);
+    expect(route).toEqual({ type: "session", sessionID: "fresh" });
+    await Bun.sleep(30);
+    expect(sent.at(-1)?.params.root_id).toBe("fresh");
+  } finally { stop?.(); }
+});
+
+test("an existing session without a resume marker gets a new root", async () => {
+  delete process.env.HERDR_OPENCODE_ROOT_ID;
+  const { default: plugin } = await import("./tui.js");
+  let route = { type: "session", sessionID: "unrelated" };
+  let created = 0;
+  const stop = await plugin.setup({
+    ui: { router: { current: () => route, navigate: (next: typeof route) => { route = next; } } },
+    data: { session: { root: (id: string) => id } },
+    client: { session: { create: async () => { created++; return sessionInfo("new-root"); } } },
+  });
+  try {
+    expect(created).toBe(1);
+    expect(route.sessionID).toBe("new-root");
+    await Bun.sleep(30);
+    expect(sent.at(-1)?.params.root_id).toBe("new-root");
+  } finally { stop?.(); }
+});
+
+test("explicit resume accepts only the current session family", async () => {
+  process.env.HERDR_OPENCODE_ROOT_ID = "root-a";
+  const { default: plugin } = await import("./tui.js");
+  let created = 0;
+  const context = (root: string) => ({
+    ui: { router: { current: () => ({ type: "session", sessionID: "child" }) } },
+    data: { session: { root: () => root } },
+    client: { session: { create: async () => { created++; return { id: "wrong" }; } } },
+  });
+  const stop = await plugin.setup(context("root-a"));
+  try {
+    expect(created).toBe(0);
+    await Bun.sleep(30);
+    expect(sent.at(-1)?.params.root_id).toBe("root-a");
+  } finally { stop?.(); }
+  await expect(plugin.setup(context("root-b"))).rejects.toThrow("resume root mismatch");
+  expect(created).toBe(0);
+});
+
+test("session creation failure stays visible and does not register", async () => {
+  delete process.env.HERDR_OPENCODE_ROOT_ID;
+  const { default: plugin } = await import("./tui.js");
+  const before = sent.length;
+  let navigated = false;
+  await expect(plugin.setup({
+    ui: { router: { current: () => ({ type: "home" }), navigate: () => { navigated = true; } } },
+    client: { session: { create: async () => { throw new Error("create failed"); } } },
+  })).rejects.toThrow("create failed");
+  expect(navigated).toBe(false);
+  expect(sent.length).toBe(before);
+});
