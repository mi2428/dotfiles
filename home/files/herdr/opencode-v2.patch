+    fn delivery_agent(&self, pane_id: &str, root_id: &str) -> bool {
+        let Some((ws_idx, pane)) = self.parse_current_public_pane_id(pane_id) else {
+            return false;
+        };
+        self.agent_info(ws_idx, pane).is_some_and(|agent| {
+            agent.agent.as_deref() == Some("opencode")
+                && agent.agent_session.as_ref().is_some_and(|session| {
+                    session.source == "herdr:opencode" && session.value == root_id
+                })
+        })
+    }
+
+    pub(in crate::app) fn clear_agent_delivery(&mut self, pane_id: &str) {
+        if let Some(mut entry) = self.agent_deliveries.remove(pane_id) {
+            if let Some(pending) = entry.pending.take() {
+                let _ = pending
+                    .completion
+                    .send(Err(std::io::Error::other("agent frontend exited")));
+            }
+        }
+    }
+
+    pub(super) fn handle_agent_delivery_poll(
+        &mut self,
+        id: String,
+        params: AgentDeliveryPollParams,
+    ) -> String {
+        if !self.delivery_agent(&params.pane_id, &params.root_id) {
+            return encode_error(
+                id,
+                "agent_delivery_root_mismatch",
+                "pane does not show this root",
+            );
+        }
+        let entry = self
+            .agent_deliveries
+            .entry(params.pane_id)
+            .or_insert_with(|| AgentDelivery {
+                root_id: params.root_id.clone(),
+                last_poll: Instant::now(),
+                pending: None,
+            });
+        if entry.root_id != params.root_id {
+            return encode_error(
+                id,
+                "agent_delivery_root_mismatch",
+                "frontend root is fixed to its first session",
+            );
+        }
+        entry.clear_expired();
+        entry.last_poll = Instant::now();
+        let pending = entry.pending.as_mut().filter(|pending| !pending.delivered);
+        let (delivery_id, text) = if let Some(pending) = pending {
+            pending.delivered = true;
+            (Some(pending.id.clone()), Some(pending.text.clone()))
+        } else {
+            (None, None)
+        };
+        encode_success(id, ResponseResult::AgentDelivery { delivery_id, text })
+    }
+
+    pub(super) fn handle_agent_delivery_complete(
+        &mut self,
+        id: String,
+        params: AgentDeliveryCompleteParams,
+    ) -> String {
+        let valid = self.delivery_agent(&params.pane_id, &params.root_id);
+        let Some(entry) = self.agent_deliveries.get_mut(&params.pane_id) else {
+            return encode_error(id, "agent_delivery_unavailable", "frontend is unavailable");
+        };
+        if !valid || entry.root_id != params.root_id || entry.last_poll.elapsed() > DELIVERY_LEASE {
+            return encode_error(id, "agent_delivery_root_mismatch", "frontend root changed");
+        }
+        entry.clear_expired();
+        if entry
+            .pending
+            .as_ref()
+            .is_none_or(|pending| pending.id != params.delivery_id || !pending.delivered)
+        {
+            return encode_error(id, "agent_delivery_unknown", "delivery is not pending");
+        }
+        if let Some(pending) = entry.pending.take() {
+            let result = if params.accepted {
+                Ok(())
+            } else {
+                Err(std::io::Error::other("frontend rejected prompt"))
+            };
+            let _ = pending.completion.send(result);
+        }
+        encode_success(id, ResponseResult::Ok {})
+    }
