+// HERDR_INTEGRATION_VERSION=14
+import net from "node:net";
+import { Plugin } from "@opencode/plugin/tui";
+import statePlugin from "../herdr-tui-session.js";
+
+function request(method, params) {
+  const socketPath = process.env.HERDR_SOCKET_PATH;
+  const endpoint = process.platform === "win32" ? `\\\\.\\pipe\\${socketPath}` : socketPath;
+  return new Promise((resolve, reject) => {
+    const client = net.createConnection(endpoint);
+    let buffer = "";
+    const timer = setTimeout(() => client.destroy(new Error("Herdr delivery timed out")), 800);
+    client.on("connect", () => client.write(JSON.stringify({ id: `oc2:${Date.now()}:${Math.random()}`, method, params }) + "\n"));
+    client.on("data", (chunk) => {
+      buffer += chunk;
+      const end = buffer.indexOf("\n");
+      if (end < 0) return;
+      clearTimeout(timer);
+      client.destroy();
+      try {
+        const response = JSON.parse(buffer.slice(0, end));
+        if (response.error) reject(new Error(response.error.message));
+        else resolve(response.result);
+      } catch (error) { reject(error); }
+    });
+    client.on("error", reject);
+    client.on("close", () => clearTimeout(timer));
+  });
+}
+
+export default Plugin.define({
+  id: "herdr.opencode.v2",
+  async setup(context) {
+    const pane_id = process.env.HERDR_PANE_ID;
+    if (process.env.HERDR_ENV !== "1" || !pane_id || !process.env.HERDR_SOCKET_PATH) return;
+    const initial = context.ui.router.current();
+    let ownedRoot;
+    const resumeRoot = process.env.HERDR_OPENCODE_ROOT_ID;
+    if (resumeRoot !== undefined) {
+      if (!resumeRoot || initial.type !== "session" || context.data.session.root(initial.sessionID) !== resumeRoot)
+        throw new Error("OpenCode resume root mismatch");
+      ownedRoot = resumeRoot;
+    } else {
+      if (initial.type !== "home" && initial.type !== "session") throw new Error("OpenCode route is not ready");
+      const created = await context.client.session.create({}, { throwOnError: true });
+      ownedRoot = created?.id;
+      if (!ownedRoot) throw new Error("OpenCode did not create a root session");
+      context.ui.router.navigate({ type: "session", sessionID: ownedRoot });
+    }
+    const stopState = statePlugin.setup(context);
+    let disposed = false;
+    let busy = false;
+    const root = () => {
+      const route = context.ui.router.current();
+      return route.type === "session" ? context.data.session.root(route.sessionID) : undefined;
+    };
+    let observedRoot = root();
+    let revision = 0;
+    const observe = () => {
+      const value = root();
+      if (value !== observedRoot) { observedRoot = value; revision++; }
+    };
+    const tick = async () => {
+      if (disposed || busy) return;
+      observe();
+      const root_id = root();
+      if (!root_id || root_id !== ownedRoot) return;
+      const initialRevision = revision;
+      busy = true;
+      const routeWatch = setInterval(observe, 20);
+      try {
+        const result = await request("agent.delivery.poll", { pane_id, root_id });
+        if (!result?.delivery_id) return;
+        const delivery_id = result.delivery_id;
+        // A switched route, including A -> B -> A, cannot accept a stale delivery.
+        observe();
+        if (disposed || revision !== initialRevision || root() !== root_id) return;
+        let accepted = false;
+        try {
+          const response = await context.client.session.prompt({ sessionID: root_id, text: result.text }, { throwOnError: true });
+          accepted = response?.id !== undefined;
+        } catch { /* A failed or uncertain send must never be retried automatically. */ }
+        try { await request("agent.delivery.complete", { pane_id, root_id, delivery_id, accepted }); }
+        catch { /* The server expires an unconfirmed delivery; do not send it again. */ }
+      } catch { /* A disconnected frontend has no lease and cannot receive prompts. */ }
+      finally { clearInterval(routeWatch); busy = false; }
+    };
+    const poll = setInterval(() => void tick(), 100);
+    void tick();
+    return () => { disposed = true; clearInterval(poll); stopState?.(); };
+  },
+});
