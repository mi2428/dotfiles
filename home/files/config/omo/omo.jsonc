{
  // Sakura-only routing. GLM handles orchestration and high-judgement work;
  // DeepSeek handles search and quick lanes. DeepSeek rejects minimal/medium
  // reasoning, so models.json aliases those levels to low/high. settings.json
  // starts on GLM max, disables cross-model fallback, telemetry, and the
  // device service. The main session needs settings.json because OmO's
  // interactive TUI ignores model_profile.
  // Official Sakura spec (updated 2026-11-18): GLM and DeepSeek each have
  // 1,048,575 context and max_tokens <= 32,000; input + max_tokens must fit
  // the context. Source: https://manual.sakura.ad.jp/cloud/ai-engine/chat-models.html
  // Local probes (2026-11-28): GLM accepted 984,297 input tokens but hung
  // near 1M twice and stopped output around 23.8K; DeepSeek accepted
  // 1,046,810 input tokens and generated 32,000 output tokens in 279.6s.
  // These are observations, not reliable operating budgets; requests have
  // an official ~5-minute processing limit. models.json holds the numeric caps.
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "models": {
    "glm": { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "max" },
    "deepseek": { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "high" }
  },
  "model_profiles": {
    "sakura": {
      "display_name": "Sakura GLM-5.3 max",
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "max" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "max" }
      ]
    }
  },
  "model_profile": "sakura",
  "agents": {
    "explore": {
      "models": [
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "low" },
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "medium" }
      ]
    },
    "librarian": {
      "models": [
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "high" },
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "medium" }
      ]
    },
    "plan-consultant": {
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "max" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "max" }
      ]
    },
    "plan-reviewer": {
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "max" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "max" }
      ]
    }
  },
  "categories": {
    "architect": {
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "max" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "max" }
      ]
    },
    "visual-engineering": {
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "max" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "high" }
      ]
    },
    "ultrabrain": {
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "max" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "max" }
      ]
    },
    "deep-high": {
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "max" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "max" }
      ]
    },
    "deep-low": {
      "models": [
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "high" },
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "medium" }
      ]
    },
    "artistry": {
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "max" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "max" }
      ]
    },
    "quick": {
      "models": [
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "low" },
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "low" }
      ]
    },
    "unspecified-low": {
      "models": [
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "high" },
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "medium" }
      ]
    },
    "unspecified-high": {
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "high" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "max" }
      ]
    },
    "writing": {
      "models": [
        { "model": "sakura/preview/GLM-5.3-Flash", "reasoning": "medium" },
        { "model": "sakura/preview/DeepSeek-V4.1-Flash-1017", "reasoning": "high" }
      ]
    }
  },
  "task": {
    "default_concurrency": 8,
    "max_depth": 1,
    "wait": {
      "default_ms": 120000,
      "max_ms": 600000
    }
  },
  "telemetry": {
    "enabled": false
  },
  "device_service": {
    "enabled": false
  },
  "git_master": {
    "include_co_authored_by": false
  }
}
