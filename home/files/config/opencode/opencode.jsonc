{
  "$schema": "https://opencode.ai/config.json",

  // Homebrew owns the OpenCode upgrade lifecycle on macOS.
  "autoupdate": false,

  // Keep conversations private and require an explicit config change before
  // OpenCode can publish a share link.
  "share": "disabled",

  // OpenCode resolves bare npm plugin names to the latest release. OmO's
  // duplicate updater stays disabled so resolution remains OpenCode-owned.
  "plugin": ["oh-my-openagent"],

  // Keep OpenAI as the default and GPT-native backend while making Bedrock's
  // Claude Opus 5 available to OmO's Claude-oriented agents.
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.3-codex-spark",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.3-codex-spark": {
          "options": {
            "reasoningEffort": "low"
          }
        }
      }
    },
    "amazon-bedrock": {
      // Opus 5 is invoked through its active global inference profile; the
      // similarly named JP catalog entry is not valid for this account.
      "options": {
        "profile": "soracom-dev",
        "region": "ap-northeast-1"
      }
    }
  },

  // Neovim owns interactive diagnostics. Agents should run the repository's
  // lint, typecheck, and test commands instead of starting another LSP stack.
  "lsp": false,

  // Herdr keeps agent sessions alive for long periods, so compact old context
  // automatically and discard obsolete tool output when possible.
  "compaction": {
    "auto": true,
    "prune": true
  },

  "watcher": {
    "ignore": [
      ".git/**",
      ".direnv/**",
      ".devenv/**",
      "node_modules/**",
      "target/**",
      "dist/**",
      "build/**",
      "result",
      "result-*"
    ]
  },

  // Keep normal local development autonomous while asking before destructive
  // worktree operations, privilege escalation, or publishing to a remote.
  "permission": {
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf *": "ask",
      "git clean *": "ask",
      "git reset --hard *": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git push *": "ask"
    }
  }
}
