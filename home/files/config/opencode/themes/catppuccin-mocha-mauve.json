{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["purple", "cyan", "green", "yellow", "blue", "red", "orange"],
    "text": {
      "base": "#cdd6f4",
      "muted": "#bac2de",
      "faint": "#9399b2",
      "action": {
        "primary": { "base": "#cdd6f4", "$disabled": "#7f849c", "$focused": "#1e1e2e", "$selected": "#cba6f7" },
        "secondary": { "base": "#bac2de", "$hovered": "#cdd6f4" },
        "destructive": { "base": "#1e1e2e", "$disabled": "#7f849c" }
      },
      "formfield": { "base": "#cdd6f4", "$hovered": "#cba6f7", "$focused": "#cba6f7", "$selected": "#cba6f7" },
      "feedback": {
        "error": { "base": "#f38ba8" },
        "warning": { "base": "#f9e2af" },
        "success": { "base": "#a6e3a1" },
        "info": { "base": "#94e2d5" }
      }
    },
    "background": {
      "base": "#1e1e2e",
      "raised": { "base": "#242436", "high": "#313244", "max": "#45475a" },
      "action": {
        "primary": { "base": "transparent", "$hovered": "#242436", "$focused": "#cba6f7" },
        "secondary": { "base": "transparent", "$hovered": "#242436" },
        "destructive": { "base": "#f38ba8" }
      },
      "formfield": { "base": "transparent" },
      "feedback": {
        "error": { "base": "transparent" },
        "warning": { "base": "transparent" },
        "success": { "base": "transparent" },
        "info": { "base": "transparent" }
      }
    },
    "border": { "base": "#313244" },
    "scrollbar": { "base": "#45475a" },
    "diff": {
      "text": { "added": "#a6e3a1", "removed": "#f38ba8", "context": "#9399b2", "hunkHeader": "#fab387" },
      "background": { "added": "#a6e3a133", "removed": "#f38ba833", "context": "transparent" },
      "highlight": { "added": "#a6e3a1", "removed": "#f38ba8" },
      "lineNumber": { "text": "#45475a", "background": { "added": "#a6e3a126", "removed": "#f38ba826" } }
    },
    "syntax": {
      "comment": "$hue.gray.400", "keyword": "$hue.purple.200", "function": "$hue.blue.200",
      "variable": "$hue.red.200", "string": "$hue.green.200", "number": "$hue.orange.200",
      "type": "$hue.yellow.200", "operator": "$hue.cyan.200", "punctuation": "$hue.gray.200"
    },
    "markdown": {
      "text": "$hue.gray.200", "heading": "$hue.purple.200", "link": "$hue.blue.200",
      "linkText": "$hue.cyan.100", "code": "$hue.green.200", "blockQuote": "$hue.yellow.200",
      "emphasis": "$hue.yellow.200", "strong": "$hue.orange.200", "horizontalRule": "$hue.gray.300",
      "listItem": "$hue.blue.200", "listEnumeration": "$hue.cyan.100", "image": "$hue.blue.200",
      "imageText": "$hue.cyan.100", "codeBlock": "$hue.gray.200"
    },
    "@dialog": { "background": { "base": "$background.raised.base", "action": { "primary": { "$hovered": "$background.raised.high" } } } }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#f5e0dc", "200": "#cdd6f4", "300": "#a6adc8", "400": "#9399b2", "500": "#7f849c",
        "600": "#585b70", "700": "#313244", "800": "#1e1e2e", "900": "#11111b"
      },
      "red": {
        "100": "#f5b8c9", "200": "#f38ba8", "300": "#d87896", "400": "#bc6884", "500": "#a15771",
        "600": "#86455d", "700": "#6b344a", "800": "#4e2637", "900": "#321825"
      },
      "orange": {
        "100": "#fbd1ae", "200": "#fab387", "300": "#db9a78", "400": "#bf8168", "500": "#a36958",
        "600": "#885348", "700": "#6b3e38", "800": "#4e2d29", "900": "#321e1d"
      },
      "yellow": {
        "100": "#fcf1cf", "200": "#f9e2af", "300": "#d8c69b", "400": "#b9a989", "500": "#9a8d76",
        "600": "#7d715f", "700": "#615548", "800": "#463c33", "900": "#2c2621"
      },
      "green": {
        "100": "#c7efc4", "200": "#a6e3a1", "300": "#91c98e", "400": "#7aae7c", "500": "#64946a",
        "600": "#507958", "700": "#3d6046", "800": "#2d4835", "900": "#203125"
      },
      "cyan": {
        "100": "#b9f0e8", "200": "#94e2d5", "300": "#80c7bd", "400": "#6caca6", "500": "#58928d",
        "600": "#467775", "700": "#365c5c", "800": "#294445", "900": "#1d2e30"
      },
      "blue": {
        "100": "#b8cbfd", "200": "#89b4fa", "300": "#789cda", "400": "#6785bd", "500": "#566e9f",
        "600": "#455982", "700": "#354565", "800": "#28334a", "900": "#1c2330"
      },
      "purple": {
        "100": "#e3d0fc", "200": "#cba6f7", "300": "#b18dd8", "400": "#9975ba", "500": "#80609b",
        "600": "#684b7e", "700": "#513b61", "800": "#3a2b47", "900": "#261d30"
      },
      "accent": "$hue.purple", "interactive": "$hue.purple", "neutral": "$hue.gray"
    }
  }
}
