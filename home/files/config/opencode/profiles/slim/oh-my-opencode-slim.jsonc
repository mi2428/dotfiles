{
  // The Sakura preset is active by default. /preset performance and
  // /preset openai keep the previous Bedrock/OpenAI lineups available.
  "preset": "sakura",
  "autoUpdate": false,
  "compactSidebar": true,
  "disabled_agents": ["observer"],
  "image_routing": "direct",
  "multiplexer": {
    // Only activate panes inside Herdr. Outside Herdr the adapter is a no-op,
    // so normal oc-slim runs keep their single-pane layout.
    "type": "herdr",
    "viewer": "tui"
  },
  "fallback": {
    "enabled": true,
    "retryDelayMs": 500,
    "maxRetries": 3
  },

  "presets": {
    // GLM owns orchestration and high-judgement work; DeepSeek owns the
    // latency-sensitive search lanes. Both run against the Sakura gateway.
    "sakura": {
      "orchestrator": {
        "model": "sakura/preview/GLM-5.3-Flash",
        "variant": "max",
        "skills": ["*"],
        "mcps": []
      },
      "oracle": {
        "model": "sakura/preview/GLM-5.3-Flash",
        "variant": "max",
        "skills": ["simplify"],
        "mcps": []
      },
      "designer": {
        "model": "sakura/preview/GLM-5.3-Flash",
        "variant": "max",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "sakura/preview/GLM-5.3-Flash",
        "variant": "max",
        "skills": [],
        "mcps": []
      },
      "librarian": {
        "model": "sakura/preview/DeepSeek-V4.1-Flash-1017",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "explorer": {
        "model": "sakura/preview/DeepSeek-V4.1-Flash-1017",
        "variant": "low",
        "skills": [],
        "mcps": []
      }
    },

    "performance": {
      // Opus 5 is used where planning quality and long-running context have
      // the largest effect. OpenAI remains the code-specialist backend.
      "orchestrator": {
        "model": "amazon-bedrock/global.anthropic.claude-opus-5",
        "variant": "max",
        "skills": ["*"],
        "mcps": []
      },
      "oracle": {
        "model": "amazon-bedrock/global.anthropic.claude-opus-5",
        "variant": "max",
        "skills": ["simplify"],
        "mcps": []
      },
      "designer": {
        "model": "amazon-bedrock/global.anthropic.claude-opus-5",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "skills": [],
        "mcps": []
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      }
    },

    // This is the current Slim-recommended OpenAI arrangement. It is useful
    // when Bedrock quota/latency is undesirable without changing the profile.
    "openai": {
      "orchestrator": {
        "model": "openai/gpt-5.6-terra",
        "variant": "xhigh",
        "skills": ["*"],
        "mcps": []
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "skills": ["simplify"],
        "mcps": []
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "designer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "xhigh",
        "skills": [],
        "mcps": []
      }
    }
  }
}
