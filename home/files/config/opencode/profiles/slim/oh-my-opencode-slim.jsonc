{
  // The performance profile is active on first launch. `/preset openai`
  // switches to the all-OpenAI mapping below and persists after reload.
  "preset": "performance",
  "autoUpdate": false,
  "compactSidebar": true,
  "disabled_agents": ["observer"],
  "image_routing": "direct",
  "multiplexer": {
    "type": "none"
  },
  "fallback": {
    "enabled": true,
    "timeoutMs": 15000,
    "retryDelayMs": 500,
    "maxRetries": 3,
    "retry_on_empty": true
  },

  "presets": {
    "performance": {
      // Opus 5 is used where planning quality and long-running context have
      // the largest effect. OpenAI remains the code-specialist backend.
      "orchestrator": {
        "model": "amazon-bedrock/global.anthropic.claude-opus-5",
        "variant": "max",
        "skills": ["*"],
        "mcps": []
      },
      "oracle": {
        "model": "amazon-bedrock/global.anthropic.claude-opus-5",
        "variant": "max",
        "skills": ["simplify"],
        "mcps": []
      },
      "designer": {
        "model": "amazon-bedrock/global.anthropic.claude-opus-5",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "skills": [],
        "mcps": []
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      }
    },

    // This is the current Slim-recommended OpenAI arrangement. It is useful
    // when Bedrock quota/latency is undesirable without changing the profile.
    "openai": {
      "orchestrator": {
        "model": "openai/gpt-5.6-terra",
        "variant": "xhigh",
        "skills": ["*"],
        "mcps": []
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "skills": ["simplify"],
        "mcps": []
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "low",
        "skills": [],
        "mcps": []
      },
      "designer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "xhigh",
        "skills": [],
        "mcps": []
      }
    }
  }
}
