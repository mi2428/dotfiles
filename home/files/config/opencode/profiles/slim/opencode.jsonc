{
  "$schema": "https://opencode.ai/config.json",

  // Homebrew owns the OpenCode upgrade lifecycle on macOS.
  "autoupdate": false,
  "share": "disabled",

  // This profile is intentionally isolated from OmO. The wrapper selects it
  // through XDG_CONFIG_HOME, so both plugins can remain installed safely.
  // `task ai.upgrade` updates this exact pin together with this profile's
  // tui.json.
  "plugin": ["oh-my-opencode-slim@2.2.9"],

  // Slim's performance preset uses Opus 5 for the orchestration path. The
  // smaller OpenAI model handles OpenCode's incidental background work.
  "model": "amazon-bedrock/global.anthropic.claude-opus-5",
  "small_model": "openai/gpt-5.3-codex-spark",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "low"
          }
        },
        "gpt-5.3-codex-spark": {
          "options": {
            "reasoningEffort": "low"
          }
        }
      }
    },
    "amazon-bedrock": {
      // Tokyo has the global Opus 5 inference profile available. The global
      // route is used because the account does not expose the JP catalog ID.
      "options": {
        "profile": "soracom-dev",
        "region": "ap-northeast-1"
      }
    }
  },
  "lsp": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".direnv/**",
      ".devenv/**",
      "node_modules/**",
      "target/**",
      "dist/**",
      "build/**",
      "result",
      "result-*"
    ]
  },
  "permission": {
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf *": "ask",
      "git clean *": "ask",
      "git reset --hard *": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git push *": "ask"
    }
  }
}
