keybind = super+shift+r=reload_config
# Use left Option for terminal Meta bindings while preserving right Option for
# macOS Unicode input.
macos-option-as-alt = left
# Keep plain ctrl-r available for fzf's native history widget. Trigger Atuin
# with left Option-R, which Ghostty receives as alt+r through macos-option-as-alt.
# Do not override alt+r with a fixed byte sequence. Let Ghostty negotiate the
# keyboard protocol with fish, tmux, Herdr, and Neovim so every application sees
# a real Alt-R key event. Right Option remains available for macOS Unicode input.
# References:
# - https://github.com/atuinsh/atuin/blob/main/crates/atuin/src/shell/atuin.zsh
# - https://github.com/atuinsh/atuin/blob/main/crates/atuin/src/shell/atuin.fish
keybind = global:cmd+shift+enter=toggle_quick_terminal
keybind = cmd+g>d=new_split:right
keybind = cmd+g>shift+d=new_split:down
keybind = cmd+g>minus=new_split:down
keybind = cmd+g>backslash=new_split:right
keybind = cmd+g>h=goto_split:left
keybind = cmd+g>j=goto_split:bottom
keybind = cmd+g>k=goto_split:top
keybind = cmd+g>l=goto_split:right
keybind = cmd+g>r=activate_key_table:resize
keybind = cmd+g>z=toggle_split_zoom
keybind = cmd+g>e=equalize_splits
keybind = cmd+g>escape=end_key_sequence
keybind = resize/
keybind = resize/h=resize_split:left,10
keybind = resize/j=resize_split:down,10
keybind = resize/k=resize_split:up,10
keybind = resize/l=resize_split:right,10
keybind = resize/escape=deactivate_key_table
keybind = resize/catch_all=ignore
font-family = Summer Ghost
font-family-bold = Summer Ghost
font-family-italic = Summer Ghost
font-family-bold-italic = Summer Ghost
# Previous font configuration: Ubuntu Mono + PlemolJP Console
# font-family = Ubuntu Mono
# font-family = PlemolJP Console
# font-family-bold = Ubuntu Mono
# font-family-bold = PlemolJP Console
# font-family-italic = Ubuntu Mono
# font-family-italic = PlemolJP Console
# font-family-bold-italic = Ubuntu Mono
# font-family-bold-italic = PlemolJP Console
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-synthetic-style = false
font-feature = -calt, -liga, -dlig
font-size = 14
alpha-blending = native
font-thicken = true
font-thicken-strength = 100
cursor-style = block
shell-integration-features = no-cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path
quick-terminal-position = top
quick-terminal-size = 50%
quick-terminal-screen = main
quick-terminal-animation-duration = 0
quick-terminal-autohide = true
quick-terminal-space-behavior = move

# Catppuccin flavour selection. Uncomment exactly one line.
# theme = catppuccin-latte.conf
# theme = catppuccin-frappe.conf
# theme = catppuccin-macchiato.conf
theme = catppuccin-mocha.conf

background-opacity = 0.92
background-opacity-cells = true
background-blur = 10
unfocused-split-opacity = 1
# custom-shader = shaders/runcat.glsl
# custom-shader = shaders/girls_last_tour_draft1.glsl
# custom-shader = shaders/girls_last_tour_draft2.glsl
# custom-shader = shaders/girls_last_tour_draft3.glsl
custom-shader-animation = true
macos-titlebar-style = tabs
macos-window-shadow = false
window-width = 230
window-height = 70
window-save-state = never
