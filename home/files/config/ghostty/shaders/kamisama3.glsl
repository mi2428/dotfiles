        .0035 * sin(cycleTime * (2.0 * PI / 7.0)) +
        .0012 * sin(cycleTime * (2.0 * PI / 6.0) + .4);
    neck.y += .0010 * sin(cycleTime * (2.0 * PI / 12.0));
    bendRatio += .0015 * sin(cycleTime * (2.0 * PI / 6.0));
}

float hatchHash(float value) {
    return fract(sin(value * 127.1 + 311.7) * 43758.5453123);
}

float sampleAnchoredBody(
    vec2 fragCoord,
    vec2 root,
    vec2 neck,
    float bendRatio,
    float pixelScale
) {
    vec2 chord = neck - root;
    float chordLength = length(chord);
    vec2 tangent = chord / max(chordLength, 0.0001);
    vec2 perpendicular = vec2(-tangent.y, tangent.x);
    float rawLongitudinal = dot(fragCoord - root, tangent) / chordLength;
    if (rawLongitudinal < 0.0 || rawLongitudinal > 1.0) return 0.0;

    float longitudinal = clamp(rawLongitudinal, 0.0, 1.0);
    float bend = bendRatio * chordLength;
    vec2 center = root + longitudinal * chord +
        bend * sin(PI * longitudinal) * perpendicular;
    vec2 sourcePosition = vec2(
        BODY_CENTER_X + dot(fragCoord - center, perpendicular) / pixelScale,
        mix(BODY_BOTTOM, BODY_TOP, longitudinal)
    );
    if (sourcePosition.x < 132.0 || sourcePosition.x > 320.0 ||
        sourcePosition.y < 197.77 || sourcePosition.y > 657.0) return 0.0;

    float neckFeather = smoothstep(197.77, 211.0, sourcePosition.y);
    float baseInk = sampleMask(sourcePosition) * neckFeather;

    float sourceY = sourcePosition.y;
    float leftOutline = 226.4312 - .100234 * sourceY;
    float rightOutline = 250.7436 + .048421 * sourceY;
    float robeWidth = max(rightOutline - leftOutline, 1.0);
    float robeU = (sourcePosition.x - leftOutline) / robeWidth;
    float verticalClip = smoothstep(450.0, 456.0, sourceY) *
        (1.0 - smoothstep(629.0, 635.0, sourceY));
    float sideClip = smoothstep(.06, .10, robeU) *
        (1.0 - smoothstep(.90, .94, robeU));
    float hatchClip = verticalClip * sideClip;

    vec2 restChord = vec2(.84, .61) * iResolution.xy -
        (iResolution.xy + vec2(20.0));
    float extension = smootherstep(
        (chordLength / max(length(restChord), 1.0) - 1.0) / .75
    );
    float hatchCount = mix(18.0, 10.0, extension);
    float keepRate = mix(.82, .42, extension);
    float hatchLongitudinal = clamp((635.0 - sourceY) / 185.0, 0.0, 1.0);
    float side = step(.5, robeU);
    float slope = mix(-2.8, 3.8, side);
    float cyclePhase = mod(iTime, 84.0) / 84.0;
    float roughness = .10 * sin(2.0 * PI * (
        7.0 * robeU + 3.0 * hatchLongitudinal + 4.0 * cyclePhase
    ));
    roughness += .045 * sin(2.0 * PI * (
        13.0 * robeU - 5.0 * hatchLongitudinal + 7.0 * cyclePhase
    ));
    float hatchPhase = hatchCount * hatchLongitudinal +
        slope * (robeU - .5) + 6.0 * cyclePhase + roughness;
    float lineIndex = floor(hatchPhase + .5);
    float seamLineIndex = mod(lineIndex, 6.0);
    float distanceToLine = abs(fract(hatchPhase + .5) - .5);
    float antialias = max(fwidth(hatchPhase) * .72, .018);
    float hatchStroke = 1.0 - smoothstep(.028, .028 + antialias, distanceToLine);
    float keep = step(hatchHash(seamLineIndex + side * 37.0), keepRate);
    float fragment = step(
        mix(.14, .30, extension),
        hatchHash(seamLineIndex * 19.0 + floor(robeU * 15.0) + side * 53.0)
    );
    float centerBreak = smoothstep(.018, .055, abs(robeU - .5));
    float hatchInk = hatchStroke * keep * fragment * centerBreak * hatchClip;
    return max(baseInk, hatchInk * .82) * neckFeather;
}

vec2 livingContourSource(
    vec2 headPosition,
    float pixelScale,
    float cycleTime
) {
    const vec2 faceCenter = vec2(232.5, 172.0);
    const vec2 faceRadius = vec2(58.5, 40.0);
    vec2 sourcePosition = headPosition;
    float faceDistance = length((headPosition - faceCenter) / faceRadius);
    float contourBand = smootherstep((faceDistance - .80) / .10) *
        (1.0 - smootherstep((faceDistance - 1.13) / .10));
    contourBand *= smootherstep((headPosition.y - 143.0) / 10.0) *
        (1.0 - smootherstep((headPosition.y - 211.0) / 5.0));

    float leftBand = contourBand *
        (1.0 - smootherstep((headPosition.x - 224.0) / 10.0));
    float rightBand = contourBand *
        smootherstep((headPosition.x - 241.0) / 10.0);
    float chinBand = contourBand *
        smootherstep((headPosition.y - 187.0) / 13.0) *
        (1.0 - smootherstep((abs(headPosition.x - faceCenter.x) - 31.0) / 9.0));

    float bandTotal = max(1.0, leftBand + rightBand + chinBand);
    leftBand /= bandTotal;
    rightBand /= bandTotal;
    chinBand /= bandTotal;

    float leftCheekPx = 4.2 * sin(cycleTime * (2.0 * PI / 7.0));
    float rightCheekPx = 4.0 * sin(
        cycleTime * (2.0 * PI / 12.0) + .72
    );
    float chinPx = 2.5 * sin(cycleTime * (2.0 * PI / 6.0) + 1.10);
    sourcePosition.x += leftBand * leftCheekPx / pixelScale;
    sourcePosition.x -= rightBand * rightCheekPx / pixelScale;
    sourcePosition.y -= chinBand * chinPx / pixelScale;
    return sourcePosition;
}

vec2 livingHairSource(
    vec2 headPosition,
    float pixelScale,
    float cycleTime
) {
    float cropX = smootherstep((headPosition.x - 168.0) / 7.0) *
        (1.0 - smootherstep((headPosition.x - 301.0) / 7.0));
    float crownTip = cropX * smootherstep((headPosition.y - 121.0) / 53.0) *
        (1.0 - smootherstep((headPosition.y - 188.0) / 5.0));
    float sideY = smootherstep((headPosition.y - 174.0) / 12.0) *
        (1.0 - smootherstep((headPosition.y - 220.0) / 5.0));
    float leftTip = sideY *
        (1.0 - smootherstep((headPosition.x - 181.0) / 14.0));
    float rightTip = sideY *
        smootherstep((headPosition.x - 285.0) / 16.0);
    float tipTotal = max(1.0, crownTip + leftTip + rightTip);
    crownTip /= tipTotal;
    leftTip /= tipTotal;
    rightTip /= tipTotal;

    vec2 crownDirection = normalize(vec2(1.0, .15));
    vec2 leftDirection = normalize(vec2(-.92, .38));
    vec2 rightDirection = normalize(vec2(.94, .34));
    vec2 displayShift =
        crownTip * crownDirection * 8.0 *
            sin(cycleTime * (2.0 * PI / 6.0)) +
        leftTip * leftDirection * 9.0 *
            sin(cycleTime * (2.0 * PI / 7.0) + .90) +
        rightTip * rightDirection * 8.0 *
            sin(cycleTime * (2.0 * PI / 12.0) + 1.80);
    return headPosition - displayShift / pixelScale;
}

float authenticBlink(float cycleTime) {
    float blinkTime = mod(cycleTime, 7.0);
    float closing = smootherstep(blinkTime / .10);
    float opening = 1.0 - smootherstep((blinkTime - .18) / .10);
    return closing * opening;
}

float sampleLivingHead(
    vec2 fragCoord,
    vec2 neck,
    float pixelScale,
    float angle,
    float cycleTime,
    out vec2 headPosition
) {
    headPosition = inverseRotate((fragCoord - neck) / pixelScale, angle) +
        HEAD_PIVOT;
    if (headPosition.x < 130.0 || headPosition.x > 324.0 ||
        headPosition.y < 99.0 || headPosition.y > 231.0) return 0.0;

    float baseInk = sampleMask(livingContourSource(
        headPosition, pixelScale, cycleTime
    ));
    float hairInk = sampleHairMask(livingHairSource(
        headPosition, pixelScale, cycleTime
    ));

    const vec2 leftEyeCenter = vec2(200.0, 179.0);
    float leftEyeHeight = max(
        .18,
        1.0 - authenticBlink(cycleTime) * (6.0 / pixelScale) / 8.0
    );
    vec2 leftEyePoint = headPosition;
    leftEyePoint.y -= 1.5 *
        sin(cycleTime * (2.0 * PI / 12.0) + .35) / pixelScale;
    vec2 leftEyeSource = leftEyeCenter +
        (leftEyePoint - leftEyeCenter) / vec2(1.0, leftEyeHeight);
    float leftEyeInk = sampleLeftEyeMask(leftEyeSource);

    const vec2 rightEyeCenter = vec2(256.0, 177.0);
    float ringScale = clamp(
        1.0 + sin(cycleTime * (2.0 * PI / 7.0) + 1.35) *
            (3.0 / pixelScale) / 4.0,
        .15,
        1.95
    );
    vec2 rightEyePoint = headPosition;
    rightEyePoint.y -= 1.5 *
        sin(cycleTime * (2.0 * PI / 6.0) + 1.20) / pixelScale;
    vec2 rightEyeSource = rightEyeCenter +
        (rightEyePoint - rightEyeCenter) / ringScale;
    float rightEyeInk = sampleRightEyeMask(rightEyeSource);

    const vec2 mouthCenter = vec2(229.0, 194.0);
    float mouthPhase = sin(cycleTime * (2.0 * PI / 12.0) + .40);
    float mouthScaleX = clamp(
        1.0 + mouthPhase * (2.5 / pixelScale) / 6.0,
        .35,
        1.65
    );
    vec2 mouthSource = headPosition;
    mouthSource.y -= 4.0 *
        sin(cycleTime * (2.0 * PI / 7.0) + 2.10) / pixelScale;
    mouthSource.x = mouthCenter.x +
        (mouthSource.x - mouthCenter.x) / mouthScaleX;
    float mouthInk = sampleMouthMask(mouthSource);

    float authenticParts = max(
        hairInk,
        max(max(leftEyeInk, rightEyeInk), mouthInk)
    );
    float neckFeather = 1.0 - smoothstep(203.0, 231.0, headPosition.y);
    return max(baseInk, authenticParts) * neckFeather;
}

float statusBoxGate(vec2 position, vec2 low, vec2 high, float feather) {
    vec2 outside = max(max(low - position, position - high), vec2(0.0));
    return 1.0 - smootherstep(max(outside.x, outside.y) / feather);
}

vec2 statusNodeLow(int index) {
    if (index == 0) return vec2(210.0, 30.0);
    if (index == 1) return vec2(260.0, 39.0);
    if (index == 2) return vec2(266.0, 64.0);
    return vec2(252.0, 91.0);
}

vec2 statusNodeHigh(int index) {
    if (index == 0) return vec2(224.0, 42.0);
    if (index == 1) return vec2(273.0, 48.0);
    if (index == 2) return vec2(279.0, 71.0);
    return vec2(263.0, 106.0);
}

float statusSourceNodeGate(vec2 sourcePosition) {
    float gate = 0.0;
    for (int index = 0; index < 4; ++index) {
        gate = max(gate, statusBoxGate(
            sourcePosition,
            statusNodeLow(index),
            statusNodeHigh(index),
            1.5
        ));
    }
    return gate;
}

float statusInnerGate(vec2 sourcePosition) {
    const vec2 orbitCenter = vec2(231.5, 63.0);
    const vec2 innerRadius = vec2(20.5, 18.0);
    float distanceToCenter = length(
        (sourcePosition - orbitCenter) / innerRadius
    );
    return 1.0 - smootherstep((distanceToCenter - .86) / .34);
}

float statusNodePeriod(int index) {
    if (index == 0) return 6.0;
    if (index == 1) return 7.0;
    if (index == 2) return 12.0;
    return 14.0;
}

float statusNodePulsePeriod(int index) {
    if (index == 0) return 7.0;
    if (index == 1) return 12.0;
    if (index == 2) return 14.0;
    return 21.0;
}

float sampleMovingStatusNode(
    vec2 headPosition,
    float pixelScale,
    float cycleTime,
    float junctionRelease,
    int index
) {
    float cycleOffset = .25 * float(index);
    float motionPhase = 2.0 * PI *
        (cycleTime / statusNodePeriod(index) + cycleOffset);
    vec2 displayMotion = vec2(
        6.0 * cos(motionPhase),
        3.9 * sin(motionPhase)
    );
    vec2 sourcePosition = headPosition -
        displayMotion * junctionRelease / pixelScale;
    float movedGate = statusBoxGate(
        sourcePosition,
        statusNodeLow(index),
        statusNodeHigh(index),
        1.5
    );

    float pulsePhase = 2.0 * PI *
        (cycleTime / statusNodePulsePeriod(index) + cycleOffset + .125);
    float opacity = mix(.35, 1.0, .5 + .5 * sin(pulsePhase));
    return sampleStatusMask(sourcePosition) * movedGate * opacity;
}

float sampleStatus(
    vec2 headPosition,
    float pixelScale,
    float cycleTime
) {
    float motionMargin = 14.0 + 7.2 / max(pixelScale, .25);
    if (headPosition.x < 180.0 - motionMargin ||
        headPosition.x > 292.0 + motionMargin ||
        headPosition.y < 20.0 - motionMargin ||
        headPosition.y > 116.0 + motionMargin) return 0.0;

    const vec2 orbitCenter = vec2(231.5, 63.0);
    const vec2 innerRadius = vec2(20.5, 18.0);
    const vec2 junction = vec2(232.0, 107.0);
    vec2 orbitDelta = headPosition - orbitCenter;
    float junctionRelease = smootherstep(length(headPosition - junction) / 18.0);

    float innerAngle = (11.0 * PI / 180.0) *
        sin(cycleTime * (2.0 * PI / 7.0)) * junctionRelease;
    float innerScale = clamp(
        1.0 + (1.25 / pixelScale) / innerRadius.x *
            sin(cycleTime * (2.0 * PI / 7.0) + .55) * junctionRelease,
        .65,
        1.35
    );
    vec2 innerSource = orbitCenter +
        inverseRotate(orbitDelta, innerAngle) / innerScale;

    vec2 unshearedPosition = headPosition;
    float shearY = clamp(orbitDelta.y / 34.0, -1.0, 1.0);
    unshearedPosition.x -= (4.0 / pixelScale) * shearY *
        sin(cycleTime * (2.0 * PI / 6.0) + .35) * junctionRelease;
    float outerAngle = (-6.0 * PI / 180.0) *
        sin(cycleTime * (2.0 * PI / 12.0) + .20) * junctionRelease;
    vec2 outerSource = orbitCenter + inverseRotate(
        unshearedPosition - orbitCenter,
        outerAngle
    );

    float innerInk = sampleStatusMask(innerSource) *
        statusInnerGate(innerSource) *
        (1.0 - statusSourceNodeGate(innerSource));
    float outerInk = sampleStatusMask(outerSource) *
        (1.0 - statusInnerGate(outerSource)) *
        (1.0 - statusSourceNodeGate(outerSource));

    float nodeInk = 0.0;
    for (int index = 0; index < 4; ++index) {
        nodeInk = max(nodeInk, sampleMovingStatusNode(
            headPosition,
            pixelScale,
            cycleTime,
            junctionRelease,
            index
        ));
    }
    return max(max(innerInk, outerInk), nodeInk);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = fragCoord / iResolution.xy;
    vec4 terminal = texture(iChannel0, uv);

    float cycleTime = mod(iTime, 84.0);
    vec2 root = iResolution.xy + vec2(20.0);
    vec2 neckNormalized;
    float bendRatio;
    bodyPose(cycleTime, neckNormalized, bendRatio);
    vec2 neck = neckNormalized * iResolution.xy;
    float pixelScale = (.69 * iResolution.y) / float(MASK_HEIGHT);

    vec2 chord = neck - root;
    float chordLength = length(chord);
    vec2 chordTangent = chord / max(chordLength, .0001);
    vec2 chordPerpendicular = vec2(-chordTangent.y, chordTangent.x);
    vec2 headTangent = normalize(chord - PI * bendRatio * chordLength *
        chordPerpendicular);
    float headAngle = atan(headTangent.x, -headTangent.y);

    float bodyInk = sampleAnchoredBody(
        fragCoord, root, neck, bendRatio, pixelScale
    );
    vec2 headPosition;
    float headInk = sampleLivingHead(
        fragCoord, neck, pixelScale, headAngle, cycleTime, headPosition
    );
    float statusInk = sampleStatus(headPosition, pixelScale, cycleTime);
    float ink = max(max(bodyInk, headInk), statusInk);

    float foregroundDistance = length(terminal.rgb - iBackgroundColor);
    float bareBackground = 1.0 - smoothstep(.055, .20, foregroundDistance);
    float readability = mix(.08, 1.0, bareBackground);
    vec3 lineColor = mix(iPalette[8], iForegroundColor, .22);
    float overlay = clamp(ink * .085, 0.0, .10) * readability;
    fragColor = vec4(mix(terminal.rgb, lineColor, overlay), terminal.a);
}
