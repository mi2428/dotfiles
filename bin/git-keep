#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1

message_prefix="keep"
case "${1:-}" in
  --fix|-f)
    message_prefix="bugfix"
    shift
    ;;
esac

if (($# == 0)); then
  cd "$repo_root"
  set -- .
fi

git add -- "$@"
git commit --only -m "${message_prefix}: $(date)" -- "$@"
