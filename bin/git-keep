#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
cd "$repo_root"

message_prefix="keep"
case "${1:-}" in
  --fix|-f)
    message_prefix="bugfix"
    shift
    ;;
esac

if (($# == 0)); then
  git add .
else
  git add -- "$@"
fi

git commit -m "${message_prefix}: $(date)"
