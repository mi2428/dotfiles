#!/usr/bin/env fish

set -g __dotfiles_git_b_self_path (path resolve (status filename))
set -l script_dir (path dirname "$__dotfiles_git_b_self_path")
set -l helper_file (path resolve "$script_dir/../home/files/config/fish/lib/dotfiles_git_ui_helpers.fish")

source "$helper_file"; or begin
    printf 'git-b: failed to source helper: %s\n' "$helper_file" >&2
    exit 1
end

function die
    printf 'git-b: %s\n' (string join ' ' -- $argv) >&2
    exit 1
end

function canonical_path --argument-names dir_path
    test -d "$dir_path"; or return 1

    set -l cwd (pwd)
    builtin cd -- "$dir_path"
    set -l resolved (pwd -P)
    builtin cd -- "$cwd"
    printf '%s\n' "$resolved"
end

function prune_worktrees
    git worktree prune >/dev/null 2>/dev/null || true
end

function current_worktree_root
    canonical_path (git rev-parse --show-toplevel)
end

function branch_worktree_path --argument-names branch
    git for-each-ref --format='%(worktreepath)' "refs/heads/$branch" | head -n 1
end

function print_preview --argument-names ref kind worktree_path
    set -l info_ref "refs/heads/$ref"

    if test "$worktree_path" = -
        set worktree_path ''
    end

    if test "$kind" = remote
        set info_ref "refs/remotes/$ref"
    end

    set -l info_line (git for-each-ref --format='%(refname:short)%09%(committerdate:relative)%09%(authorname)%09%(subject)%09%(upstream:short)%09%(worktreepath)' "$info_ref")
    if test -n "$info_line"
        set -l fields (string split \t -- "$info_line")
        printf 'branch: %s\nupdated: %s\nauthor: %s\nsubject: %s\nupstream: %s\nworktree: %s\n' \
            "$fields[1]" "$fields[2]" "$fields[3]" "$fields[4]" "$fields[5]" "$fields[6]"
    end

    if test -n "$worktree_path"
        printf '\nworktree path: %s\n' "$worktree_path"
    end

    printf '\n'
    git log --max-count=10 --oneline --graph --date=short --color=always \
        --pretty='format:%C(auto)%cd %h%d %s' "$ref" -- || true

    printf '\n%s\n' '────────────────────────────────────────'
    printf '%s\n' 'diff vs HEAD'
    git diff --stat --color=always "HEAD...$ref" || true
end

function branch_picker
    set -l scope all
    set -l selection_mode single
    set -l prompt 'branch> '
    set -l tab \t
    set -l exclude_local_ref ''

    if test (count $argv) -ge 1
        set scope "$argv[1]"
    end
    if test (count $argv) -ge 2
        set selection_mode "$argv[2]"
    end
    if test (count $argv) -ge 3
        set prompt "$argv[3]"
    end
    if test (count $argv) -ge 4
        set exclude_local_ref "$argv[4]"
    end

    command -q fzf; or die 'fzf is not installed'
    command -q python3; or die 'python3 is not installed'

    set -l size (__dotfiles_git_ui_current_terminal_size)
    set -l cols $size[1]

    if not string match -rq '^[0-9]+$' -- "$cols"
        set cols 160
    end

    prune_worktrees

    set -l list_width (math -s0 "$cols - ($cols * 42 / 100) - 5")
    if test "$list_width" -le 72
        set list_width 72
    end

    set -l ref_args
    set -l exclude_args

    switch "$scope"
        case all
            set ref_args refs/heads refs/remotes
            set exclude_args '--exclude=refs/remotes/*/HEAD'
        case local
            set ref_args refs/heads
            if test -n "$exclude_local_ref"
                set exclude_args "--exclude=refs/heads/$exclude_local_ref"
            end
        case '*'
            die "unknown branch picker scope: $scope"
    end

    set -l fzf_args \
        --ansi \
        --no-sort \
        "--prompt=$prompt" \
        "--delimiter=$tab" \
        --with-nth=5 \
        --preview-window=right,42%,border-left,wrap \
        "--preview=$__dotfiles_git_b_self_path __preview {1} {2} {4}" \
        --bind=ctrl-/:change-preview-window\(right,42%,border-left,wrap\|down,55%,border-top,wrap\)

    # Keep ANSI columns visible when the parent terminal exports NO_COLOR.
    set -lx NO_COLOR ''

    switch "$selection_mode"
        case multi
            set -a fzf_args \
                --multi \
                --bind=tab:toggle+down,btab:toggle+up
        case single
        case '*'
            die "unknown branch picker selection mode: $selection_mode"
    end

    set -l selected (
        git for-each-ref \
            --sort=-committerdate \
            --format='%(refname:short)%09%(refname)%09%(committerdate:relative)%09%(authorname)%09%(subject)%09%(worktreepath)' \
            $exclude_args \
            $ref_args \
        | __dotfiles_git_ui_format_fzf_rows branches "$list_width" "$HOME" \
        | fzf $fzf_args
    )
    or return 1

    test -n "$selected"; or return 1
    printf '%s\n' $selected
end

function delete_selected_branches
    set -l current_branch (git branch --show-current 2>/dev/null)
    set -l selected_blob (branch_picker local multi 'delete branch> ' "$current_branch" | string collect); or return $status
    set -l branches

    for line in (string split \n -- "$selected_blob")
        set -l fields (string split \t -- "$line")
        test -n "$fields[1]"; and set -a branches "$fields[1]"
    end

    test (count $branches) -gt 0; or return 1
    delete_branches $branches
end

function delete_branches --argument-names branch_names
    prune_worktrees

    set -l current_root (current_worktree_root)
    set -l deletion_branches
    set -l deletion_worktrees

    for branch in $argv
        test -n "$branch"; or continue

        set -l worktree_path (branch_worktree_path "$branch")
        if test -n "$worktree_path"
            set -l resolved_worktree "$worktree_path"
            if test -d "$worktree_path"
                set resolved_worktree (canonical_path "$worktree_path")
            end

            if test -n "$resolved_worktree"; and test "$resolved_worktree" = "$current_root"
                printf 'git-b: refusing to delete branch %s checked out in the current worktree\n' "$branch" >&2
                return 1
            end
        end

        set -a deletion_branches "$branch"
        set -a deletion_worktrees "$worktree_path"
    end

    for idx in (seq (count $deletion_branches))
        set -l branch "$deletion_branches[$idx]"
        set -l worktree_path "$deletion_worktrees[$idx]"

        if test -n "$worktree_path"
            command git worktree remove --force -- "$worktree_path"; or begin
                printf 'git-b: failed to remove worktree %s for branch %s\n' "$worktree_path" "$branch" >&2
                return 1
            end
        end

        command git branch -D -- "$branch"; or return $status
    end

    prune_worktrees
end

function switch_to_selected --argument-names ref kind switch_target selected_worktree
    set -l current_root (current_worktree_root)
    set -l target_worktree "$selected_worktree"

    if test "$target_worktree" = -
        set target_worktree ''
    end

    prune_worktrees

    if test "$kind" = remote
        if git show-ref --verify --quiet "refs/heads/$switch_target"
            set target_worktree (branch_worktree_path "$switch_target")
        end
    end

    if test -n "$target_worktree"
        set -l resolved_target (canonical_path "$target_worktree")
        if test $status -eq 0
            set target_worktree "$resolved_target"
        else
            set target_worktree ''
        end
    end

    if test -n "$target_worktree"; and test "$target_worktree" != "$current_root"
        printf 'cd\t%s\t%s\n' "$target_worktree" "$switch_target"
        return 0
    end

    if test "$kind" = remote
        if git show-ref --verify --quiet "refs/heads/$switch_target"
            printf 'switch\t%s\n' "$switch_target"
        else
            printf 'track\t%s\t%s\n' "$switch_target" "$ref"
        end
        return 0
    end

    printf 'switch\t%s\n' "$ref"
end

function execute_action --argument-names action arg1 arg2
    switch "$action"
        case cd
            printf 'git-b: branch %s is already checked out at %s\n' "$arg2" "$arg1" >&2
            return 2
        case switch
            exec git switch -- "$arg1"
        case track
            exec git switch --track -c "$arg1" "$arg2"
        case '*'
            die "unknown action: $action"
    end
end

function main
    if test (count $argv) -ge 1
        switch "$argv[1]"
            case __preview
                print_preview "$argv[2]" "$argv[3]" "$argv[4]"
                return 0
            case __resolve-action
                git rev-parse --is-inside-work-tree >/dev/null 2>/dev/null || die 'not inside a git work tree'
                set -l selected (branch_picker); or return $status
                set -l fields (string split \t -- "$selected")
                switch_to_selected "$fields[1]" "$fields[2]" "$fields[3]" "$fields[4]"
                return $status
            case __delete-branches
                git rev-parse --is-inside-work-tree >/dev/null 2>/dev/null || die 'not inside a git work tree'
                test (count $argv) -ge 2; or die '__delete-branches requires at least one branch'
                delete_branches $argv[2..-1]
                return $status
        end
    end

    if test (count $argv) -eq 1; and test "$argv[1]" = -D
        git rev-parse --is-inside-work-tree >/dev/null 2>/dev/null || die 'not inside a git work tree'
        delete_selected_branches
        return $status
    end

    if test (count $argv) -gt 0
        exec git branch $argv
    end

    git rev-parse --is-inside-work-tree >/dev/null 2>/dev/null || die 'not inside a git work tree'

    set -l action_line (main __resolve-action); or return $status
    set -l fields (string split \t -- "$action_line")
    execute_action "$fields[1]" "$fields[2]" "$fields[3]"
end

main $argv
