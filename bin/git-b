#!/usr/bin/env bash
set -euo pipefail

tab=$'\t'
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
git_fzf_format_bin="${script_dir}/git-fzf-format"

die() {
  printf 'git-b: %s\n' "$*" >&2
  exit 1
}

canonical_path() {
  [[ -d "$1" ]] || return 1
  cd -- "$1" && pwd -P
}

prune_worktrees() {
  git worktree prune >/dev/null 2>&1 || true
}

current_worktree_root() {
  canonical_path "$(git rev-parse --show-toplevel)"
}

branch_worktree_path() {
  local branch=$1
  git for-each-ref --format='%(worktreepath)' "refs/heads/${branch}" | head -n 1
}

print_preview() {
  local ref=${1:-}
  local kind=${2:-}
  local worktree_path=${3:-}
  local info_ref="refs/heads/${ref}"

  if [[ "$worktree_path" == "-" ]]; then
    worktree_path=""
  fi

  if [[ "$kind" == "remote" ]]; then
    info_ref="refs/remotes/${ref}"
  fi

  git for-each-ref \
    --format=$'branch: %(refname:short)\nupdated: %(committerdate:relative)\nauthor: %(authorname)\nsubject: %(subject)\nupstream: %(upstream:short)\nworktree: %(worktreepath)' \
    "$info_ref"

  if [[ -n "$worktree_path" ]]; then
    printf '\nworktree path: %s\n' "$worktree_path"
  fi

  printf '\n'
  git log --max-count=10 --oneline --graph --date=short --color=always \
    --pretty='format:%C(auto)%cd %h%d %s' "$ref" -- || true

  printf '\n%s\n' '────────────────────────────────────────'
  printf '%s\n' 'diff vs HEAD'
  git diff --stat --color=always "HEAD...$ref" || true
}

branch_picker() {
  local scope=${1:-all}
  local selection_mode=${2:-single}
  local prompt=${3:-branch> }
  command -v fzf >/dev/null 2>&1 || die 'fzf is not installed'
  [[ -x "$git_fzf_format_bin" ]] || die "missing required helper: $git_fzf_format_bin"

  local cols tty_size list_width selected
  local -a ref_args exclude_args fzf_args
  cols=""

  if [[ -n "${TMUX:-}" ]]; then
    cols=$(tmux display-message -p '#{pane_width}' 2>/dev/null || true)
  fi

  if [[ -z "$cols" ]]; then
    tty_size="$(stty size 2>/dev/null || true)"
    if [[ "$tty_size" =~ ^([0-9]+)[[:space:]]+([0-9]+)$ ]]; then
      cols="${BASH_REMATCH[2]}"
    fi
  fi

  if [[ -z "$cols" && -n "${COLUMNS:-}" ]]; then
    cols=$COLUMNS
  fi

  if [[ -z "$cols" ]]; then
    cols=$(tput cols 2>/dev/null || printf '160\n')
  fi

  [[ "$cols" =~ ^[0-9]+$ ]] || cols=160

  prune_worktrees

  list_width=$(( cols - (cols * 42 / 100) - 5 ))
  (( list_width > 72 )) || list_width=72

  case "$scope" in
    all)
      ref_args=(refs/heads refs/remotes)
      exclude_args=("--exclude=refs/remotes/*/HEAD")
      ;;
    local)
      ref_args=(refs/heads)
      exclude_args=()
      ;;
    *)
      die "unknown branch picker scope: $scope"
      ;;
  esac

  fzf_args=(
    --ansi
    --no-sort
    "--prompt=${prompt}"
    "--delimiter=${tab}"
    --with-nth=5
    "--preview-window=right,42%,border-left,wrap"
    "--preview=bash '$0' __preview {1} {2} {4}"
    "--bind=ctrl-/:change-preview-window(right,42%,border-left,wrap|down,55%,border-top,wrap)"
  )

  if [[ "$selection_mode" == "multi" ]]; then
    fzf_args+=(--multi)
  elif [[ "$selection_mode" != "single" ]]; then
    die "unknown branch picker selection mode: $selection_mode"
  fi

  selected="$(
    git for-each-ref \
      --sort=-committerdate \
      --format='%(refname:short)%09%(refname)%09%(committerdate:relative)%09%(authorname)%09%(subject)%09%(worktreepath)' \
      "${exclude_args[@]}" \
      "${ref_args[@]}" \
      | "$git_fzf_format_bin" branches "$list_width" "${HOME:-}" \
      | fzf "${fzf_args[@]}"
  )"

  [[ -n "$selected" ]] || return 1
  printf '%s\n' "$selected"
}

delete_selected_branches() {
  local selected
  local -a branches=()

  selected=$(branch_picker local multi 'delete branch> ') || return $?

  while IFS=$'\t' read -r ref _; do
    [[ -n "$ref" ]] || continue
    branches+=("$ref")
  done <<<"$selected"

  (( ${#branches[@]} > 0 )) || return 1
  exec git branch -D -- "${branches[@]}"
}

switch_to_selected() {
  local ref=$1
  local kind=$2
  local switch_target=$3
  local selected_worktree=$4
  local current_root target_worktree

  current_root=$(current_worktree_root)
  target_worktree=$selected_worktree

  if [[ "$target_worktree" == "-" ]]; then
    target_worktree=""
  fi

  prune_worktrees

  if [[ "$kind" == "remote" ]] && git show-ref --verify --quiet "refs/heads/${switch_target}"; then
    target_worktree=$(branch_worktree_path "$switch_target")
  fi

  if [[ -n "$target_worktree" ]]; then
    if ! target_worktree=$(canonical_path "$target_worktree"); then
      target_worktree=""
    fi
  fi

  if [[ -n "$target_worktree" && "$target_worktree" != "$current_root" ]]; then
    printf 'cd\t%s\t%s\n' "$target_worktree" "$switch_target"
    return 0
  fi

  if [[ "$kind" == "remote" ]]; then
    if git show-ref --verify --quiet "refs/heads/${switch_target}"; then
      printf 'switch\t%s\n' "$switch_target"
    else
      printf 'track\t%s\t%s\n' "$switch_target" "$ref"
    fi
    return 0
  fi

  printf 'switch\t%s\n' "$ref"
}

execute_action() {
  local action=${1:-}
  local arg1=${2:-}
  local arg2=${3:-}

  case "$action" in
    cd)
      printf 'git-b: branch %s is already checked out at %s\n' "$arg2" "$arg1" >&2
      return 2
      ;;
    switch)
      exec git switch -- "$arg1"
      ;;
    track)
      exec git switch --track -c "$arg1" "$arg2"
      ;;
    *)
      die "unknown action: $action"
      ;;
  esac
}

main() {
  if [[ "${1:-}" == "__preview" ]]; then
    shift
    print_preview "${1:-}" "${2:-}" "${3:-}"
    return 0
  fi

  if [[ "${1:-}" == "__resolve-action" ]]; then
    shift
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'not inside a git work tree'

    local selected ref kind switch_target worktree_path
    selected=$(branch_picker) || return $?
    IFS=$'\t' read -r ref kind switch_target worktree_path _ <<<"$selected"
    switch_to_selected "$ref" "$kind" "$switch_target" "$worktree_path"
    return $?
  fi

  if (( $# == 1 )) && [[ "${1:-}" == "-D" ]]; then
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'not inside a git work tree'
    delete_selected_branches
    return $?
  fi

  if (( $# > 0 )); then
    exec git branch "$@"
  fi

  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'not inside a git work tree'

  local action_line action arg1 arg2
  action_line=$(main __resolve-action) || return $?
  IFS=$'\t' read -r action arg1 arg2 <<<"$action_line"
  execute_action "$action" "$arg1" "$arg2"
}

main "$@"
