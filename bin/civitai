#!/usr/bin/env bash
set -euo pipefail

ssh_host="gpu"
destination=""
declare -a files=()

usage() {
  cat <<'EOF'
Usage:
  civitai [options] [files...]

Options:
  -b,  --base        upload to ~/io/stable-diffusion-webui-docker/data/models/Stable-diffusion
  -a,  --adetailer   upload to ~/io/stable-diffusion-webui-docker/data/models/adetailer
  -l,  --lora        upload to ~/io/stable-diffusion-webui-docker/data/models/Lora
  -la                upload to ~/io/stable-diffusion-webui-docker/data/models/Lora/artist
  -lb                upload to ~/io/stable-diffusion-webui-docker/data/models/Lora/background
  -lc                upload to ~/io/stable-diffusion-webui-docker/data/models/Lora/character
  -lq                upload to ~/io/stable-diffusion-webui-docker/data/models/Lora/quality
  -ls                upload to ~/io/stable-diffusion-webui-docker/data/models/Lora/style
  -lp                upload to ~/io/stable-diffusion-webui-docker/data/models/Lora/pose
  -lx                upload to ~/io/stable-diffusion-webui-docker/data/models/Lora/xxx
  -L,  --lycoris     upload to ~/io/stable-diffusion-webui-docker/data/models/LyCORIS
  -e,  --embedding   upload to ~/io/stable-diffusion-webui-docker/data/embeddings
  -c,  --controlnet  upload to ~/io/stable-diffusion-webui-docker/data/models/ControlNet
  -v,  --vae         upload to ~/io/stable-diffusion-webui-docker/data/models/VAE
  -E,  --esrgan      upload to ~/io/stable-diffusion-webui-docker/data/models/ESRGAN
EOF
}

parse_args() {
  while (($#)); do
    case "$1" in
      --base|-b) destination="io/stable-diffusion-webui-docker/data/models/Stable-diffusion" ;;
      --adetailer|--adetaiiler|-a) destination="io/stable-diffusion-webui-docker/data/models/adetailer" ;;
      --lora|-l) destination="io/stable-diffusion-webui-docker/data/models/Lora" ;;
      -la) destination="io/stable-diffusion-webui-docker/data/models/Lora/artist" ;;
      -lb) destination="io/stable-diffusion-webui-docker/data/models/Lora/background" ;;
      -lc) destination="io/stable-diffusion-webui-docker/data/models/Lora/character" ;;
      -lq) destination="io/stable-diffusion-webui-docker/data/models/Lora/quality" ;;
      -ls) destination="io/stable-diffusion-webui-docker/data/models/Lora/style" ;;
      -lp) destination="io/stable-diffusion-webui-docker/data/models/Lora/pose" ;;
      -lx) destination="io/stable-diffusion-webui-docker/data/models/Lora/xxx" ;;
      --lycoris|-L) destination="io/stable-diffusion-webui-docker/data/models/LyCORIS" ;;
      --embedding|-e) destination="io/stable-diffusion-webui-docker/data/embeddings" ;;
      --controlnet|-c) destination="io/stable-diffusion-webui-docker/data/models/ControlNet" ;;
      --vae|-v) destination="io/stable-diffusion-webui-docker/data/models/VAE" ;;
      --esrgan|-E) destination="io/stable-diffusion-webui-docker/data/models/ESRGAN" ;;
      --help|-h)
        usage
        exit 0
        ;;
      --*|-*)
        printf 'civitai: unknown option: %s\n' "$1" >&2
        usage >&2
        return 1
        ;;
      *)
        files+=("$1")
        ;;
    esac
    shift
  done

  [[ -n "$destination" && ${#files[@]} -gt 0 ]]
}

main() {
  parse_args "$@" || {
    usage >&2
    exit 1
  }

  scp "${files[@]}" "${ssh_host}:~/${destination}" && rm -i -- "${files[@]}"
}

main "$@"
