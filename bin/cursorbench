#!/usr/bin/env python3
"""Display the official CursorBench leaderboard in the terminal."""

from __future__ import annotations

import argparse
import math
import os
import re
import shutil
import sys
from collections.abc import Sequence
from dataclasses import dataclass
from html.parser import HTMLParser
from itertools import pairwise
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

URL = "https://cursor.com/cursorbench"
TIMEOUT = 10
COLUMN_COUNT = 6
MAX_SCORE = 100
SCORE_TICK = 5
GRAPH_GUTTER = 7
SCORE_RE = re.compile(r"^(\d+(?:\.\d+)?)%$")
COST_RE = re.compile(r"^\$(\d+(?:\.\d+)?)$")
INTEGER_RE = re.compile(r"^\d[\d,]*$")
EFFORT_RE = re.compile(r" (?:extra high|max|high|medium|low)\*?$", re.IGNORECASE)
MODEL_ALIASES = {"claude": ("opus", "sonnet", "haiku", "fable")}
LEADERBOARD_HEADERS = ("model", "score", "cost", "tokens", "steps")
RESET = "\033[0m"
RGB = tuple[int, int, int]
BRAILLE_BITS = ((1, 8), (2, 16), (4, 32), (64, 128))
MOCHA: dict[str, RGB] = {
    "text": (205, 214, 244),
    "subtext0": (166, 173, 200),
    "mauve": (203, 166, 247),
    "pink": (245, 194, 231),
    "red": (243, 139, 168),
    "peach": (250, 179, 135),
    "yellow": (249, 226, 175),
    "green": (166, 227, 161),
    "teal": (148, 226, 213),
    "sky": (137, 220, 235),
    "sapphire": (116, 199, 236),
    "blue": (137, 180, 250),
    "lavender": (180, 190, 254),
    "base": (30, 30, 46),
    "mantle": (24, 24, 37),
    "surface2": (88, 91, 112),
}
MODEL_COLORS: tuple[tuple[str, str], ...] = (
    ("fable", "peach"),
    ("opus", "mauve"),
    ("sonnet", "pink"),
    ("luna", "green"),
    ("terra", "teal"),
    ("sol", "blue"),
    ("gpt", "sky"),
    ("gemini", "sapphire"),
    ("grok", "red"),
    ("kimi", "yellow"),
    ("glm", "green"),
    ("composer", "lavender"),
)


@dataclass(frozen=True, slots=True)
class Result:
    source_rank: int
    model: str
    score: float
    cost: float
    tokens: int
    steps: int


@dataclass(frozen=True, slots=True)
class Series:
    name: str
    results: tuple[Result, ...]
    color: RGB


@dataclass(frozen=True, slots=True)
class GraphScale:
    cost_max: float
    score_min: float
    score_max: float
    pixel_width: int
    pixel_height: int

    def position(self, result: Result) -> tuple[int, int]:
        x = round(
            (self.cost_max - result.cost) / self.cost_max * (self.pixel_width - 1)
        )
        y = round(
            (self.score_max - result.score)
            / (self.score_max - self.score_min)
            * (self.pixel_height - 1)
        )
        return x, y


class BrailleCanvas:
    def __init__(self, width: int, height: int) -> None:
        self.width = width
        self.height = height
        self.pixel_width = width * 2
        self.pixel_height = height * 4
        self._bits = [[0] * width for _ in range(height)]
        self._colors: list[list[RGB | None]] = [[None] * width for _ in range(height)]
        self._glyphs: list[list[str | None]] = [[None] * width for _ in range(height)]
        self._glyph_colors: list[list[RGB | None]] = [
            [None] * width for _ in range(height)
        ]

    def set_pixel(self, x: int, y: int, color: RGB) -> None:
        if not 0 <= x < self.pixel_width or not 0 <= y < self.pixel_height:
            return
        cell_x, dot_x = divmod(x, 2)
        cell_y, dot_y = divmod(y, 4)
        self._bits[cell_y][cell_x] |= BRAILLE_BITS[dot_y][dot_x]
        self._colors[cell_y][cell_x] = color

    def draw_line(
        self,
        start: tuple[int, int],
        end: tuple[int, int],
        color: RGB,
    ) -> None:
        x0, y0 = start
        x1, y1 = end
        dx = abs(x1 - x0)
        dy = -abs(y1 - y0)
        step_x = 1 if x0 < x1 else -1
        step_y = 1 if y0 < y1 else -1
        error = dx + dy

        while True:
            self.set_pixel(x0, y0, color)
            if x0 == x1 and y0 == y1:
                break
            doubled = error * 2
            if doubled >= dy:
                error += dy
                x0 += step_x
            if doubled <= dx:
                error += dx
                y0 += step_y

    def set_glyph(self, x: int, y: int, glyph: str, color: RGB) -> None:
        if 0 <= x < self.width and 0 <= y < self.height:
            self._glyphs[y][x] = glyph
            self._glyph_colors[y][x] = color

    def place_label(self, x: int, y: int, text: str, color: RGB) -> bool:
        if x < 0 or y < 0 or y >= self.height or x + len(text) > self.width:
            return False
        if any(
            self._glyphs[y][column] is not None or self._bits[y][column]
            for column in range(x, x + len(text))
        ):
            return False
        for column, character in enumerate(text, x):
            self._glyphs[y][column] = character
            self._glyph_colors[y][column] = color
        return True

    def row(self, index: int, *, grid: bool = False) -> list[tuple[str, RGB | None]]:
        cells: list[tuple[str, RGB | None]] = []
        for column in range(self.width):
            if glyph := self._glyphs[index][column]:
                cells.append((glyph, self._glyph_colors[index][column]))
            elif bits := self._bits[index][column]:
                cells.append((chr(0x2800 | bits), self._colors[index][column]))
            elif grid:
                cells.append(("·" if column % 2 == 0 else " ", MOCHA["surface2"]))
            else:
                cells.append((" ", None))
        return cells


class TableParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.tables: list[list[list[str]]] = []
        self._depth = 0
        self._rows: list[list[str]] | None = None
        self._row: list[str] | None = None
        self._cell: list[str] | None = None

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        del attrs
        if tag == "table":
            self._depth += 1
            if self._depth == 1:
                self._rows = []
        elif self._depth == 1 and tag == "tr":
            self._row = []
        elif self._depth == 1 and tag in {"th", "td"} and self._row is not None:
            self._cell = []

    def handle_data(self, data: str) -> None:
        if self._cell is not None:
            self._cell.append(data)

    def handle_endtag(self, tag: str) -> None:
        if self._depth == 1 and tag in {"th", "td"} and self._cell is not None:
            if self._row is not None:
                self._row.append(" ".join("".join(self._cell).split()))
            self._cell = None
        elif self._depth == 1 and tag == "tr" and self._row is not None:
            if self._rows is not None:
                self._rows.append(self._row)
            self._row = None
        elif tag == "table" and self._depth:
            if self._depth == 1:
                if self._rows is not None:
                    self.tables.append(self._rows)
                self._rows = None
            self._depth -= 1


def parse_row(cells: list[str]) -> Result | None:
    if len(cells) != COLUMN_COUNT or not cells[0].isdigit():
        return None

    score = SCORE_RE.fullmatch(cells[2])
    cost = COST_RE.fullmatch(cells[3])
    if (
        not score
        or not cost
        or not INTEGER_RE.fullmatch(cells[4])
        or not INTEGER_RE.fullmatch(cells[5])
    ):
        return None

    result = Result(
        source_rank=int(cells[0]),
        model=cells[1],
        score=float(score.group(1)),
        cost=float(cost.group(1)),
        tokens=int(cells[4].replace(",", "")),
        steps=int(cells[5].replace(",", "")),
    )
    if (
        not result.model
        or not math.isfinite(result.score)
        or not math.isfinite(result.cost)
        or not 0 <= result.score <= MAX_SCORE
        or result.cost < 0
    ):
        raise ValueError("CursorBench returned an invalid leaderboard row")
    return result


def parse_leaderboard(html: str) -> list[Result]:
    parser = TableParser()
    parser.feed(html)
    parser.close()

    leaderboards: list[list[Result]] = []
    for table in parser.tables:
        header = " ".join(table[0]).casefold() if table else ""
        if not all(label in header for label in LEADERBOARD_HEADERS):
            continue

        results: list[Result] = []
        for row in table[1:]:
            if not row or not row[0].isdigit():
                continue
            result = parse_row(row)
            if result is None:
                raise ValueError("CursorBench returned an invalid leaderboard row")
            results.append(result)
        if results:
            leaderboards.append(results)

    if not leaderboards:
        raise ValueError("CursorBench leaderboard table was not found")
    if any(results != leaderboards[0] for results in leaderboards[1:]):
        raise ValueError("CursorBench returned conflicting leaderboard tables")

    results = leaderboards[0]
    ranks = [result.source_rank for result in results]
    if ranks != list(range(1, len(results) + 1)) or len(
        {result.model for result in results}
    ) != len(results):
        raise ValueError("CursorBench returned an invalid leaderboard ranking")
    return results


def fetch_leaderboard() -> list[Result]:
    request = Request(URL, headers={"User-Agent": "cursorbench/1.0"})
    with urlopen(request, timeout=TIMEOUT) as response:
        encoding = response.headers.get_content_charset() or "utf-8"
        return parse_leaderboard(response.read().decode(encoding))


def model_filter(value: str) -> tuple[str, ...]:
    filters = tuple(
        part.strip().casefold() for part in value.split(",") if part.strip()
    )
    if not filters:
        raise argparse.ArgumentTypeError("expected a comma-separated model list")
    return filters


def matches_model(result: Result, filters: tuple[str, ...]) -> bool:
    name = result.model.casefold()
    return any(
        query in name or any(alias in name for alias in MODEL_ALIASES.get(query, ()))
        for query in filters
    )


def foreground(rgb: RGB, *, bold: bool = False) -> str:
    weight = "1;" if bold else ""
    return f"\033[{weight}38;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def background(rgb: RGB) -> str:
    return f"\033[48;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def model_color(model: str) -> RGB:
    name = model.casefold()
    return next(
        (MOCHA[color] for family, color in MODEL_COLORS if family in name),
        MOCHA["lavender"],
    )


def series_name(model: str) -> str:
    return EFFORT_RE.sub("", model)


def build_series(results: list[Result]) -> list[Series]:
    groups: dict[str, list[Result]] = {}
    for result in results:
        groups.setdefault(series_name(result.model), []).append(result)
    return [
        Series(name, tuple(group), model_color(name)) for name, group in groups.items()
    ]


def pareto_frontier(results: list[Result]) -> list[Result]:
    frontier = [
        candidate
        for candidate in results
        if not any(
            other is not candidate
            and other.cost <= candidate.cost
            and other.score >= candidate.score
            and (other.cost < candidate.cost or other.score > candidate.score)
            for other in results
        )
    ]
    return sorted(
        frontier,
        key=lambda result: (result.cost, result.score, result.source_rank),
    )


def render_cells(cells: Sequence[tuple[str, RGB | None]], *, ansi: bool) -> str:
    if not ansi:
        return "".join(character for character, _color in cells)

    rendered: list[str] = []
    active_color: RGB | None = None
    for character, color in cells:
        if color != active_color:
            rendered.append(RESET if color is None else foreground(color))
            active_color = color
        rendered.append(character)
    if active_color is not None:
        rendered.append(RESET)
    return "".join(rendered)


def nice_step(maximum: float, divisions: int = 6) -> float:
    rough = maximum / divisions
    magnitude = 10.0 ** math.floor(math.log10(rough)) if rough else 1.0
    if not math.isfinite(magnitude) or magnitude == 0:
        return maximum or 1
    normalized = rough / magnitude
    multiplier = next(value for value in (1, 2, 3, 5, 10) if normalized <= value)
    step = multiplier * magnitude
    return step if math.isfinite(step) and step > 0 else maximum


def make_graph_scale(
    results: list[Result], canvas: BrailleCanvas
) -> tuple[GraphScale, float]:
    max_cost = max(result.cost for result in results)
    cost_step = nice_step(max_cost, max(2, min(6, canvas.width // 10)))
    rounded_cost = math.ceil(max_cost / cost_step) * cost_step
    cost_max = (
        max_cost if not math.isfinite(rounded_cost) else max(cost_step, rounded_cost)
    )
    score_min = (
        math.floor(min(result.score for result in results) / SCORE_TICK) * SCORE_TICK
    )
    score_max = (
        math.ceil(max(result.score for result in results) / SCORE_TICK) * SCORE_TICK
    )
    if score_min == score_max:
        score_min -= SCORE_TICK
        score_max += SCORE_TICK
    scale = GraphScale(
        cost_max,
        score_min,
        score_max,
        canvas.pixel_width,
        canvas.pixel_height,
    )
    return scale, cost_step


def draw_series(
    canvas: BrailleCanvas, series: list[Series], scale: GraphScale
) -> list[Series]:
    draw_order = sorted(
        series,
        key=lambda item: min(result.source_rank for result in item.results),
        reverse=True,
    )
    for item in draw_order:
        points = [
            scale.position(result)
            for result in sorted(item.results, key=lambda row: row.cost)
        ]
        for start, end in pairwise(points):
            canvas.draw_line(start, end, item.color)

    for item in draw_order:
        for result in item.results:
            x, y = scale.position(result)
            canvas.set_glyph(x // 2, y // 4, "●", item.color)
    return draw_order


def draw_frontier(
    canvas: BrailleCanvas, results: list[Result], scale: GraphScale
) -> None:
    points = [scale.position(result) for result in pareto_frontier(results)]
    for start, end in pairwise(points):
        canvas.draw_line(start, end, MOCHA["yellow"])
        canvas.draw_line(
            (start[0], start[1] + 1),
            (end[0], end[1] + 1),
            MOCHA["yellow"],
        )
    for x, y in points:
        canvas.set_glyph(x // 2, y // 4, "◆", MOCHA["yellow"])


def place_series_labels(
    canvas: BrailleCanvas, draw_order: list[Series], scale: GraphScale
) -> list[Series]:
    legend: list[Series] = []
    for item in reversed(draw_order):
        anchor = min(item.results, key=lambda result: result.source_rank)
        pixel_x, pixel_y = scale.position(anchor)
        cell_x, cell_y = pixel_x // 2, pixel_y // 4
        candidates = (
            (cell_x + 2, cell_y - 1),
            (cell_x + 2, cell_y + 1),
            (cell_x - len(item.name) - 2, cell_y - 1),
            (cell_x - len(item.name) - 2, cell_y + 1),
            (cell_x + 2, cell_y - 2),
            (cell_x - len(item.name) - 2, cell_y + 2),
        )
        if not any(
            canvas.place_label(x, y, item.name, item.color) for x, y in candidates
        ):
            legend.append(item)
    return legend


def score_tick_rows(scale: GraphScale) -> dict[int, float]:
    score_span = scale.score_max - scale.score_min
    divisions = max(2, scale.pixel_height // 12)
    tick_step = max(SCORE_TICK, nice_step(score_span, divisions))
    scores = [scale.score_min]
    score = math.ceil(scale.score_min / tick_step) * tick_step
    while score < scale.score_max:
        if score > scale.score_min:
            scores.append(score)
        score += tick_step
    scores.append(scale.score_max)

    tick_rows: dict[int, float] = {}
    for score in scores:
        pixel = round(
            (scale.score_max - score)
            / (scale.score_max - scale.score_min)
            * (scale.pixel_height - 1)
        )
        row = pixel // 4
        if row not in tick_rows or score in {scale.score_min, scale.score_max}:
            tick_rows[row] = score
    return tick_rows


def render_plot_rows(
    canvas: BrailleCanvas, scale: GraphScale, *, ansi: bool
) -> list[str]:
    tick_rows = score_tick_rows(scale)
    lines: list[str] = []
    for row in range(canvas.height):
        if row in tick_rows:
            prefix = f"{tick_rows[row]:>3.0f}% ┤ "
            grid = True
        else:
            prefix = "     │ "
            grid = False
        cells: list[tuple[str, RGB | None]] = [
            (character, MOCHA["surface2"]) for character in prefix
        ]
        cells.extend(canvas.row(row, grid=grid))
        lines.append(render_cells(cells, ansi=ansi).rstrip())
    return lines


def render_cost_axis(
    canvas: BrailleCanvas,
    scale: GraphScale,
    cost_step: float,
    *,
    ansi: bool,
) -> list[str]:
    axis = list("     └─" + "─" * canvas.width)
    label_line = [" "] * len(axis)
    tick_count = max(1, round(scale.cost_max / cost_step))
    costs = [scale.cost_max * (index / tick_count) for index in range(tick_count + 1)]
    for cost in costs:
        cell_x = round((scale.cost_max - cost) / scale.cost_max * (canvas.width - 1))
        axis[GRAPH_GUTTER + cell_x] = "┬"

    label_costs = [costs[-1], costs[0], *reversed(costs[1:-1])]
    for cost in label_costs:
        cell_x = round((scale.cost_max - cost) / scale.cost_max * (canvas.width - 1))
        label = f"${cost:g}"
        start = max(
            GRAPH_GUTTER,
            min(
                len(label_line) - len(label),
                GRAPH_GUTTER + cell_x - len(label) // 2,
            ),
        )
        end = start + len(label)
        if all(character == " " for character in label_line[start:end]):
            label_line[start:end] = label
    lines = [
        render_cells([(character, MOCHA["surface2"]) for character in axis], ansi=ansi)
    ]
    lines.append(
        render_cells(
            [(character, MOCHA["subtext0"]) for character in label_line],
            ansi=ansi,
        ).rstrip()
    )
    axis_title = "Cost / Task"
    lines.append(" " * max(0, (len(axis) - len(axis_title)) // 2) + axis_title)
    return lines


def render_legend(legend: list[Series], width: int, *, ansi: bool) -> list[str]:
    lines: list[list[tuple[str, RGB | None]]] = []
    cells: list[tuple[str, RGB | None]] = [(" ", None)] * GRAPH_GUTTER
    for item in legend:
        available = width - GRAPH_GUTTER - 2
        name = item.name
        if len(name) > available:
            name = name[: max(1, available - 1)] + "…"
        token = [("●", item.color)]
        token.extend((character, MOCHA["subtext0"]) for character in f" {name}")
        separator = [(" ", None), (" ", None)] if len(cells) > GRAPH_GUTTER else []
        if len(cells) + len(separator) + len(token) > width:
            if len(cells) > GRAPH_GUTTER:
                lines.append(cells)
            cells = [(" ", None)] * GRAPH_GUTTER
            separator = []
        cells.extend(separator)
        cells.extend(token)
    lines.append(cells)
    return [render_cells(line, ansi=ansi) for line in lines]


def render_graph(
    results: list[Result],
    *,
    ansi: bool = False,
    columns: int | None = None,
    rows: int | None = None,
) -> str:
    terminal = shutil.get_terminal_size((120, 32))
    graph_columns = max(24, min(columns or terminal.columns, 140))
    graph_rows = rows or max(14, min(24, terminal.lines - 8))
    canvas = BrailleCanvas(graph_columns - GRAPH_GUTTER, graph_rows)
    scale, cost_step = make_graph_scale(results, canvas)
    draw_order = draw_series(canvas, build_series(results), scale)
    draw_frontier(canvas, results, scale)
    legend = place_series_labels(canvas, draw_order, scale)

    lines = render_plot_rows(canvas, scale, ansi=ansi)
    lines.extend(render_cost_axis(canvas, scale, cost_step, ansi=ansi))
    if legend:
        lines.extend(render_legend(legend, graph_columns, ansi=ansi))
    frontier_key: list[tuple[str, RGB | None]] = [(" ", None)] * GRAPH_GUTTER
    frontier_key.extend(
        (character, MOCHA["yellow"]) for character in "◆ Pareto frontier"
    )
    lines.append(render_cells(frontier_key, ansi=ansi))

    return "\n" + "\n".join(lines)


def render_table(
    headers: tuple[str, ...],
    rows: list[tuple[str, ...]],
    models: list[str],
    right_aligned: set[int],
    *,
    ansi: bool,
) -> str:
    widths = [
        max(len(header), *(len(row[index]) for row in rows))
        for index, header in enumerate(headers)
    ]

    def format_row(row: Sequence[str]) -> str:
        cells = (
            value.rjust(widths[index])
            if index in right_aligned
            else value.ljust(widths[index])
            for index, value in enumerate(row)
        )
        return "  ".join(cells)

    table_width = sum(widths) + 2 * (len(widths) - 1)
    lines = [
        format_row(headers),
        "─" * table_width,
    ]

    for index, (model, row) in enumerate(zip(models, rows, strict=True)):
        line = format_row(row)
        if ansi:
            line = line.replace(
                "●",
                foreground(model_color(model)) + "●" + foreground(MOCHA["text"]),
                1,
            )
            line = (
                background(MOCHA["base" if index % 2 == 0 else "mantle"])
                + foreground(MOCHA["text"])
                + line
                + RESET
            )
        lines.append(line)

    if not ansi:
        return "\n" + "\n".join(lines)

    lines[0] = foreground(MOCHA["subtext0"], bold=True) + lines[0] + RESET
    lines[1] = foreground(MOCHA["surface2"]) + lines[1] + RESET
    return "\n" + "\n".join(lines)


def render(results: list[Result], *, ansi: bool = False) -> str:
    headers = ("Rank", "Model", "Score", "Cost / Task", "Tokens / Task", "Steps / Task")
    rows = [
        (
            str(result.source_rank),
            f"● {result.model}",
            f"{result.score:.1f}%",
            f"${result.cost:.2f}",
            f"{result.tokens:,}",
            f"{result.steps:,}",
        )
        for result in results
    ]
    return render_table(
        headers,
        rows,
        [result.model for result in results],
        {0, 2, 3, 4, 5},
        ansi=ansi,
    )


def render_pareto(results: list[Result], *, ansi: bool = False) -> str:
    frontier = pareto_frontier(results)
    rows: list[tuple[str, ...]] = []
    previous: Result | None = None
    for result in frontier:
        if previous is None:
            delta_score = delta_cost = marginal_cost = "—"
        else:
            score_gain = result.score - previous.score
            cost_increase = result.cost - previous.cost
            delta_score = f"+{score_gain:.1f}pp"
            delta_cost = f"+${cost_increase:.2f}"
            marginal_cost = (
                f"${cost_increase / score_gain:.3f}" if score_gain > 0 else "—"
            )
        rows.append(
            (
                f"● {result.model}",
                f"{result.score:.1f}%",
                f"${result.cost:.2f}",
                delta_score,
                delta_cost,
                marginal_cost,
            )
        )
        previous = result

    headers = (
        "Model",
        "Score",
        "Cost / Task",
        "ΔScore",
        "ΔCost",
        "Cost / +1pp",
    )
    return render_table(
        headers,
        rows,
        [result.model for result in frontier],
        {1, 2, 3, 4, 5},
        ansi=ansi,
    )


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Display the official CursorBench ranking.",
    )
    parser.add_argument(
        "--models",
        type=model_filter,
        metavar="MODEL,...",
        help=(
            "include models matching any comma-separated name "
            "(claude matches Claude families)"
        ),
    )
    parser.add_argument("--no-color", action="store_true", help="disable ANSI colors")
    parser.add_argument(
        "--graph",
        action="store_true",
        help="render a Braille cost/score graph before the table",
    )
    parser.add_argument(
        "--pareto",
        action="store_true",
        help="show the Pareto frontier with marginal cost metrics",
    )
    args = parser.parse_args(argv)

    try:
        results = fetch_leaderboard()
    except HTTPError as error:
        print(f"cursorbench: Cursor returned HTTP {error.code}", file=sys.stderr)
        return 1
    except (URLError, TimeoutError, UnicodeError, ValueError) as error:
        print(f"cursorbench: {error}", file=sys.stderr)
        return 1

    if args.models:
        results = [result for result in results if matches_model(result, args.models)]
        if not results:
            print("cursorbench: no models matched --models", file=sys.stderr)
            return 1

    results.sort(key=lambda result: result.source_rank)
    ansi = sys.stdout.isatty() and not args.no_color and "NO_COLOR" not in os.environ
    if args.graph:
        print(render_graph(results, ansi=ansi))
    print(
        render_pareto(results, ansi=ansi) if args.pareto else render(results, ansi=ansi)
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
