#!/usr/bin/env bash
set -euo pipefail

delta_bin="$(command -v delta 2>/dev/null || true)"
less_bin="$(command -v less 2>/dev/null || printf '%s' less)"

[[ -n "$delta_bin" ]] || {
  printf 'git-delta-lazygit: missing required command: delta\n' >&2
  exit 127
}

paging='never'
added_label=$'\033[1;38;2;166;227;161mA\033[0m'
copied_label=$'\033[1;38;2;148;226;213mC\033[0m'
modified_label=$'\033[1;38;2;249;226;175mM\033[0m'
removed_label=$'\033[1;38;2;243;139;168mD\033[0m'
renamed_label=$'\033[1;38;2;137;180;250mR\033[0m'
delta_args=(
  --features=catppuccin-mocha
  --dark
  "--file-added-label=${added_label}"
  "--file-copied-label=${copied_label}"
  "--file-modified-label=${modified_label}"
  "--file-removed-label=${removed_label}"
  "--file-renamed-label=${renamed_label}"
  --line-numbers
  --side-by-side
)

if [[ -t 1 ]]; then
  paging='always'
  delta_args+=(--pager "${less_bin} -Rc")
fi

if [[ -z "${TMUX:-}" ]]; then
  delta_args+=(
    --hyperlinks
    '--hyperlinks-file-link-format=lazygit-edit://{path}:{line}'
  )
fi

exec "$delta_bin" --paging="$paging" "${delta_args[@]}"
