#!/bin/sh
set -eu

die() {
    printf 'opencode-v2: %s\n' "$*" >&2
    exit 69
}

opencode_bin=$(command -v opencode) || die 'OpenCode is not installed'
version_output=$("$opencode_bin" --version) || die 'could not read the OpenCode version'
version=${version_output##* }
version=${version#v}

case "$version" in
    *-* | *+*) die "a stable OpenCode release is required (found: $version_output)" ;;
    '' | *[!0-9.]* | .* | *..* | *.) die "invalid OpenCode version: $version_output" ;;
    *.*.*.*) die "invalid OpenCode version: $version_output" ;;
    *.*.*) ;;
    *) die "invalid OpenCode version: $version_output" ;;
esac

major=${version%%.*}
rest=${version#*.}
minor=${rest%%.*}
if [ "$major" -lt 2 ] \
    || { [ "$major" -eq 2 ] && [ "$minor" -lt 2 ]; }; then
    die "OpenCode 2.2.0 or newer is required (found: $version_output)"
fi

if [ "${HERDR_ENV:-}" = 1 ]; then
    case "${1:-}" in
        --version | -v | --help | -h) ;;
        *)
            private_config=${DOTFILES_OPENCODE_HERDR_PRIVATE_CONFIG:-}
            [ -n "$private_config" ] \
                && [ "${XDG_CONFIG_HOME:-}/opencode" = "$private_config" ] \
                && [ -f "$private_config/opencode.jsonc" ] \
                && [ -f "$private_config/cli.json" ] \
                || die 'Herdr OpenCode V2 must use the managed private profile'

            standalone=false
            for arg in "$@"; do
                case "$arg" in
                    --standalone) standalone=true ;;
                    --server | --server=* | --attach | --attach=*)
                        die 'Herdr OpenCode V2 cannot use a shared server'
                        ;;
                esac
            done
            [ "$standalone" = true ] || die 'Herdr OpenCode V2 requires --standalone'
            unset DOTFILES_OPENCODE_HERDR_PRIVATE_CONFIG
            ;;
    esac
fi

exec "$opencode_bin" "$@"
