#!/usr/bin/env bash
set -euo pipefail

repo_url="${1:-}"
dir_path="${2:-}"

usage() {
  printf 'Usage: %s <repository-url> [directory]\n' "$(basename "$0")" >&2
}

[[ -n "$repo_url" ]] || {
  usage
  exit 1
}

if [[ -z "$dir_path" ]]; then
  dir_path="$(basename "$repo_url" .git)"
fi

git clone "$repo_url" "$dir_path"
cd "$dir_path"

current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
while IFS= read -r remote_branch; do
  remote_branch="${remote_branch#origin/}"
  [[ "$remote_branch" == "HEAD" || "$remote_branch" == "$current_branch" ]] && continue

  if ! git show-ref --verify --quiet "refs/heads/${remote_branch}"; then
    git branch --track "$remote_branch" "origin/${remote_branch}"
  fi
done < <(git for-each-ref --format='%(refname:short)' refs/remotes/origin)

git fetch --all
git pull --all
