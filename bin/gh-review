#!/usr/bin/env fish

set -g __dotfiles_gh_review_self_path (path resolve (status filename))
set -g __dotfiles_gh_review_script_dir (path dirname "$__dotfiles_gh_review_self_path")
set -l helper_file (path resolve "$__dotfiles_gh_review_script_dir/../home/files/config/fish/lib/dotfiles_git_ui_helpers.fish")

source "$helper_file"; or begin
    printf 'gh-review: failed to source helper: %s\n' "$helper_file" >&2
    exit 1
end

set -l glow_style_path "$HOME/.config/glow/styles/catppuccin-mocha.json"
if set -q XDG_CONFIG_HOME
    set glow_style_path "$XDG_CONFIG_HOME/glow/styles/catppuccin-mocha.json"
end

function die
    printf 'gh-review: %s\n' (string join ' ' -- $argv) >&2
    exit 1
end

function need_cmd --argument-names name
    command -q -- "$name"; or die "missing required command: $name"
end

function usage
    printf '%s\n' \
        'Usage:' \
        '  gh-review [pr-number|pr-url]' \
        '  gh-review --local [base-ref]' \
        '' \
        'Open a tmux review session with Neovim, a Snacks Explorer sidebar,' \
        'and Trouble workspace diagnostics.' \
        '' \
        'PR reviews create or reuse a detached review worktree under:' \
        '  ~/.cache/gh-review/<owner>/<repo>/pr-<number>' \
        '' \
        "Local reviews stay in the current repository and default to origin's default branch." \
        '' \
        'Run this from inside the target git repository.'
end

function run_edit_pane --argument-names user_shell nvim_server
    set -l target_files $argv[3..-1]
    set -l open_diagnostics 'Trouble diagnostics open open_no_results=true'
    set -l load_review_buffers 'lua require("config.review").load_arglist_async()'

    if test (count $target_files) -gt 0
        # env NVIM_AUTO_TERMINAL=1 nvim --listen "$nvim_server" -- $target_files
        nvim --listen "$nvim_server" -c "$open_diagnostics" -c "$load_review_buffers" -- $target_files
    else
        # env NVIM_AUTO_TERMINAL=1 nvim --listen "$nvim_server"
        nvim --listen "$nvim_server" -c "$open_diagnostics"
    end

    command rm -f -- "$nvim_server"
    exec "$user_shell"
end

function is_binary_diff_file --argument-names worktree_path diff_ref path
    set -l numstat (git -C "$worktree_path" diff --numstat "$diff_ref" -- "$path")
    set -l fields (string split \t -- "$numstat")

    test (count $fields) -ge 2; and test "$fields[1]" = -; and test "$fields[2]" = -
end

function switch_or_attach_tmux --argument-names session
    if set -q GH_REVIEW_NO_ATTACH; and test "$GH_REVIEW_NO_ATTACH" = 1
        return 0
    end

    if set -q TMUX
        tmux switch-client -t "$session"
    else
        tmux attach-session -t "$session"
    end
end

function session_has_attached_client --argument-names session
    tmux list-clients -F '#{session_name}' 2>/dev/null | grep -Fxq -- "$session"
end

function detect_remote --argument-names owner repo
    set -l owner_re (string escape --style=regex -- "$owner")
    set -l repo_re (string escape --style=regex -- "$repo")
    set -l pattern "github\\.com[:/]$owner_re/$repo_re(\\.git)?\$"

    if git remote get-url origin >/dev/null 2>/dev/null
        set -l url (git remote get-url origin 2>/dev/null)
        if string match -rq -- "$pattern" "$url"
            printf '%s\n' origin
            return 0
        end
    end

    for remote in (git remote)
        set -l url (git remote get-url "$remote" 2>/dev/null)
        if string match -rq -- "$pattern" "$url"
            printf '%s\n' "$remote"
            return 0
        end
    end

    die "could not determine a git remote for $owner/$repo"
end

function resolve_local_base
    set -l remote origin
    if test (count $argv) -ge 1
        set remote "$argv[1]"
    end

    set -l symbolic_ref (git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null)
    if test -n "$symbolic_ref"
        printf '%s\n' "$symbolic_ref"
        return 0
    end

    if git show-ref --verify --quiet "refs/remotes/$remote/main"
        printf '%s/main\n' "$remote"
        return 0
    end

    if git show-ref --verify --quiet "refs/remotes/$remote/master"
        printf '%s/master\n' "$remote"
        return 0
    end

    die "could not resolve a default local review base for $remote; pass --local <base-ref>"
end

function normalize_local_base --argument-names base
    set -l remote origin
    if test (count $argv) -ge 2
        set remote "$argv[2]"
    end

    if test "$base" = "$remote/HEAD"
        resolve_local_base "$remote"
        return 0
    end

    printf '%s\n' "$base"
end

function set_tmux_env --argument-names session key value
    if test -n "$value"
        tmux set-environment -t "$session" "$key" "$value"
    end
end

function select_open_pr --argument-names self_path
    need_cmd fzf
    need_cmd python3

    set -l tab \t
    set -l size (__dotfiles_git_ui_current_terminal_size)
    set -l cols $size[1]
    set -l preview_width_percent 42
    set -l preview_cmd "$self_path --preview-pr {1}"

    if not string match -rq '^[0-9]+$' -- "$cols"
        set cols 160
    end

    set -l list_width (math -s0 "$cols - ($cols * $preview_width_percent / 100) - 5")
    if test "$list_width" -le 72
        set list_width 72
    end

    # Keep ANSI columns visible when the parent terminal exports NO_COLOR.
    set -lx NO_COLOR ''

    set -l selected (
        gh pr list \
            --state open \
            --limit 200 \
            --json number,title,author,updatedAt,baseRefName,headRefName,url \
            --jq '.[] | [.number, .headRefName, .baseRefName, .updatedAt[0:10], .author.login, .title, .url] | @tsv' \
        | __dotfiles_git_ui_format_fzf_rows prs "$list_width" '' \
        | fzf \
            --ansi \
            --no-sort \
            --delimiter="$tab" \
            --with-nth=3 \
            --prompt='pr> ' \
            --preview="$preview_cmd" \
            --preview-window="right,$preview_width_percent%,border-left,wrap"
    )
    or return 1

    test -n "$selected"; or return 1

    set -l fields (string split \t -- "$selected")
    printf '%s\n' "$fields[1]"
end

if test (count $argv) -ge 1
    switch "$argv[1]"
        case -h --help
            usage
            exit 0
        case --preview-pr
            test (count $argv) -eq 2; or die '--preview-pr requires a PR number or URL'
            __dotfiles_git_ui_render_pr_preview "$argv[2]" "$glow_style_path"
            exit 0
        case --edit-pane
            test (count $argv) -ge 3; or die '--edit-pane requires a user shell and Neovim server address'
            run_edit_pane "$argv[2]" "$argv[3]" $argv[4..-1]
            exit 0
    end
end

need_cmd git
# need_cmd lazygit
need_cmd tmux
need_cmd nvim

set -l repo_root (git rev-parse --show-toplevel 2>/dev/null); or die 'run this inside a git repository'
builtin cd "$repo_root"

set -l mode pr
set -l pr_ref ''
set -l local_base_arg ''

if test (count $argv) -ge 1
    switch "$argv[1]"
        case --local
            set mode local
            if test (count $argv) -ge 2
                set local_base_arg "$argv[2]"
            end
            test (count $argv) -le 2; or die 'expected at most one base ref after --local'
        case '*'
            test (count $argv) -le 1; or die 'expected at most one PR argument'
            set pr_ref "$argv[1]"
    end
end

set -l repo_name (basename "$repo_root")
set -l review_base ''
set -l worktree_path ''
set -l session_name ''
set -l window_name ''
set -l pr_number ''
set -l head_ref HEAD
set -l user_shell /bin/bash
set -l size (__dotfiles_git_ui_current_terminal_size)
set -l session_width $size[1]
set -l session_height $size[2]
set -l cache_home "$HOME/.cache"

if set -q SHELL
    set user_shell "$SHELL"
end
if set -q XDG_CACHE_HOME
    set cache_home "$XDG_CACHE_HOME"
end

if test "$mode" = local
    set -l remote origin
    git remote get-url "$remote" >/dev/null 2>/dev/null; or die 'local review requires an origin remote'

    set -l resolved_base (resolve_local_base "$remote")
    if test -n "$local_base_arg"
        set resolved_base "$local_base_arg"
    end
    set review_base (normalize_local_base "$resolved_base" "$remote")

    if string match -q -- "$remote/*" "$review_base"
        git fetch --prune "$remote" (string replace "$remote/" '' -- "$review_base") >/dev/null
    end

    set worktree_path "$repo_root"
    set -l current_ref (git symbolic-ref --quiet --short HEAD 2>/dev/null)
    if test -z "$current_ref"
        set current_ref (git rev-parse --short HEAD)
    end

    set -l head_slug (__dotfiles_git_ui_slugify "$current_ref")
    set -l base_slug (__dotfiles_git_ui_slugify "$review_base")
    test -n "$head_slug"; or set head_slug head
    test -n "$base_slug"; or set base_slug base

    set session_name (printf '%s' "review-$repo_name-local-$head_slug-$base_slug" | tr '/._' '-' | tr -cd '[:alnum:]-' | cut -c1-48)
    set window_name (string sub -s 1 -l 48 -- "local-$head_slug")
else
    need_cmd gh
    need_cmd jq

    set -l repo_name_with_owner (gh repo view --json nameWithOwner --jq .nameWithOwner)
    set -l repo_parts (string split / -- "$repo_name_with_owner")
    set -l repo_owner "$repo_parts[1]"
    set repo_name "$repo_parts[2]"

    if test -z "$pr_ref"
        set pr_ref (select_open_pr "$__dotfiles_gh_review_self_path"); or exit 1
    end

    set -l pr_meta
    if test -n "$pr_ref"
        set pr_meta (gh pr view "$pr_ref" --json number,title,url,baseRefName,headRefName --jq '[.number,.title,.url,.baseRefName,.headRefName] | @tsv')
    else
        set pr_meta (gh pr view --json number,title,url,baseRefName,headRefName --jq '[.number,.title,.url,.baseRefName,.headRefName] | @tsv')
    end

    set -l pr_fields (string split \t -- "$pr_meta")
    set pr_number "$pr_fields[1]"
    set -l pr_url "$pr_fields[3]"
    set -l base_ref "$pr_fields[4]"
    set head_ref "$pr_fields[5]"

    test -n "$pr_number"; or die 'failed to resolve the pull request'

    set -l url_parts (string split / -- "$pr_url")
    set -l pr_owner "$url_parts[4]"
    set -l pr_repo "$url_parts[5]"

    test "$pr_owner" = "$repo_owner"; and test "$pr_repo" = "$repo_name"; or die "PR $pr_url does not belong to the current repository ($repo_name_with_owner)"

    set -l remote (detect_remote "$repo_owner" "$repo_name")
    set review_base "$remote/$base_ref"
    set -l cache_root "$cache_home/gh-review/$repo_owner/$repo_name"
    set worktree_path "$cache_root/pr-$pr_number"
    set -l head_slug (__dotfiles_git_ui_slugify "$head_ref")
    test -n "$head_slug"; or set head_slug "pr-$pr_number"
    set -l local_branch (string sub -s 1 -l 72 -- "review/pr-$pr_number-$head_slug")
    set session_name (printf '%s' "review-$repo_name-$pr_number-$head_slug" | tr '/._' '-' | tr -cd '[:alnum:]-' | cut -c1-48)
    set window_name (string sub -s 1 -l 48 -- "$pr_number-$head_slug")

    mkdir -p "$cache_root"

    if test -e "$worktree_path"
        git -C "$worktree_path" rev-parse --is-inside-work-tree >/dev/null 2>/dev/null; or die "path exists and is not a git worktree: $worktree_path"
    else
        git worktree add --detach "$worktree_path" HEAD >/dev/null
    end

    git -C "$worktree_path" fetch --prune "$remote" "$base_ref" >/dev/null
    set -l cwd (pwd)
    begin
        builtin cd "$worktree_path"
        gh pr checkout "$pr_number" --branch "$local_branch" --force >/dev/null
    end
    builtin cd "$cwd"
end

if tmux has-session -t "$session_name" 2>/dev/null
    if session_has_attached_client "$session_name"
        printf 'gh-review: reusing tmux session %s\n' "$session_name"
        switch_or_attach_tmux "$session_name"
        exit 0
    end

    tmux kill-session -t "$session_name"
end

set -l edit_targets
for path in (git -C "$worktree_path" diff --name-only --diff-filter=ACMR "$review_base...HEAD")
    if test -f "$worktree_path/$path"; and not is_binary_diff_file "$worktree_path" "$review_base...HEAD" "$path"
        set -a edit_targets "$path"
    end
end

set -l nvim_server "/tmp/gh-review-"(id -u)"-"$fish_pid".sock"

set -l edit_cmd (string join ' ' -- (string escape -- "$__dotfiles_gh_review_self_path" --edit-pane "$user_shell" "$nvim_server" $edit_targets))

set -l edit_pane (tmux new-session -d -P -F '#{pane_id}' -x "$session_width" -y "$session_height" -s "$session_name" -n "$window_name" -c "$worktree_path" "$user_shell")
set_tmux_env "$session_name" NVIM_REVIEW_MODE 1
set_tmux_env "$session_name" NVIM_REVIEW_BASE "$review_base"
set_tmux_env "$session_name" NVIM_REVIEW_HEAD HEAD
set_tmux_env "$session_name" NVIM_REVIEW_PR "$pr_number"
set_tmux_env "$session_name" NVIM_REVIEW_REPO_ROOT "$repo_root"
set_tmux_env "$session_name" NVIM_REVIEW_WORKTREE "$worktree_path"
set_tmux_env "$session_name" NVIM_REVIEW_SERVER "$nvim_server"
tmux resize-window -x "$session_width" -y "$session_height" -t "$session_name:$window_name"
tmux respawn-pane -k -t "$edit_pane" -c "$worktree_path" "$edit_cmd"; or die 'failed to start Neovim review pane'
tmux select-pane -t "$edit_pane"

if test -n "$pr_number"
    printf 'gh-review: session=%s pr=#%s base=%s worktree=%s\n' \
        "$session_name" "$pr_number" "$review_base" "$worktree_path"
else
    printf 'gh-review: session=%s base=%s worktree=%s\n' \
        "$session_name" "$review_base" "$worktree_path"
end

switch_or_attach_tmux "$session_name"
