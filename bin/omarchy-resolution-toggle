#!/usr/bin/env bash
set -euo pipefail

# Cycle this MBP's logical display sizes without changing its native 120 Hz mode.
instance=$(hyprctl instances -j | jq -er '
  if length == 1 then .[0].instance else error("Expected one Hyprland session") end')

display_width() {
  hyprctl -i "$instance" monitors -j | jq -er '
    [.[] | select(.name == "eDP-1" and .width == 3024 and .height == 1964
      and .disabled != true and .mirrorOf == "none")]
    | if length == 1 then (.[0].width / .[0].scale | round)
      else error("Expected the active 3024x1964 internal display") end'
}

case "$(display_width)" in
  2294)
    width=2704
    height=1756
    ;;
  2704)
    width=3024
    height=1964
    ;;
  3024)
    width=2294
    height=1490
    ;;
  *)
    echo 'Current display size is not one of the three MBP presets' >&2
    exit 1
    ;;
esac

config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua"
if [[ ! -f $config || ! -w $config || -L $config ]]; then
  echo 'Expected a writable monitors.lua file, not a symlink' >&2
  exit 1
fi
temporary=$(mktemp "$config.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
awk -v width="$width" '
  /^local logical_width = (2294|2704|3024)$/ { $0 = "local logical_width = " width; count++ }
  { print }
  END { if (count != 1) { print "Expected one logical_width preset in monitors.lua" > "/dev/stderr"; exit 1 } }
' "$config" >"$temporary"
chmod --reference="$config" "$temporary"
cp -pT --remove-destination -- "$config" "$config.before-resolution-toggle"
mv -fT -- "$temporary" "$config"
if hyprctl -i "$instance" reload; then
  for _ in {1..20}; do
    if [[ $(display_width) == "$width" ]]; then
      printf 'Display area: %sx%s\n' "$width" "$height"
      exit 0
    fi
    sleep 0.05
  done
fi
echo 'Display change failed; restoring previous monitors.lua' >&2
mv -fT -- "$config.before-resolution-toggle" "$config"
hyprctl -i "$instance" reload
exit 1
