#!/usr/bin/env bash
set -euo pipefail

matched_notes=()
notes_dir="${NOTES_DIR:-$HOME/notes}"
quicknote_format="quicknote-%Y-%m-%d-%H%M"
note_ext="md"
basename_cmd="$(basename "$0")"

ensure_notes_dir() {
  mkdir -p "$notes_dir" || {
    printf '[E] Failed to create notes directory: %s\n' "$notes_dir" >&2
    exit 254
  }
  cd "$notes_dir" || exit 254
}

list_notes() {
  local -a ls_opts=("$@")

  if (($# == 0)); then
    ls_opts=(-1t)
  fi

  ls "${ls_opts[@]}"
}

open_note_dir() {
  if command -v open >/dev/null 2>&1; then
    open .
  elif command -v nautilus >/dev/null 2>&1; then
    nautilus .
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open .
  else
    printf '[E] No supported file browser command was found.\n' >&2
    return 127
  fi
}

collect_matching_notes() {
  local file=""
  local file_lc=""
  local keyword=""
  local keyword_lc=""
  local matches_all=1
  local -a keywords=("$@")

  matched_notes=()
  shopt -s nullglob

  for file in *; do
    [[ -f "$file" ]] || continue

    if ((${#keywords[@]} == 0)); then
      matched_notes+=("$file")
      continue
    fi

    file_lc="$(printf '%s' "$file" | tr '[:upper:]' '[:lower:]')"
    matches_all=1
    for keyword in "${keywords[@]}"; do
      keyword_lc="$(printf '%s' "$keyword" | tr '[:upper:]' '[:lower:]')"
      if [[ "$file_lc" != *"$keyword_lc"* ]]; then
        matches_all=0
        break
      fi
    done

    ((matches_all)) && matched_notes+=("$file")
  done

  shopt -u nullglob
}

select_note() {
  collect_matching_notes "$@"

  case "${#matched_notes[@]}" in
    0)
      printf '[E] No matching notes were found.\n' >&2
      return 1
      ;;
    1)
      printf '%s\n' "${matched_notes[0]}"
      ;;
    *)
      command -v fzf >/dev/null 2>&1 || {
        printf '[E] Multiple notes matched and fzf is unavailable.\n' >&2
        printf '%s\n' "${matched_notes[@]}" >&2
        return 1
      }
      # fzf removes ANSI sequences from the accepted value, so this colours
      # the list without altering the filename passed to the editor.
      printf '%s\n' "${matched_notes[@]}" |
        sed $'s/^/\033[38;2;180;190;254m/; s/$/\033[0m/' |
        NO_COLOR='' fzf --ansi
      ;;
  esac
}

edit_note() {
  local note=""
  local -a editor_cmd=()

  note="$(select_note "$@")" || return $?
  read -r -a editor_cmd <<<"${EDITOR:-nvim}"
  "${editor_cmd[@]}" "$note"
}

new_note() {
  local note_name=""
  local keyword=""
  local -a keywords=("$@")

  if ((${#keywords[@]} == 0)); then
    note_name="$(date +"$quicknote_format")"
  else
    for keyword in "${keywords[@]}"; do
      keyword="${keyword// /-}"
      [[ -n "$note_name" ]] && note_name+="-"
      note_name+="$keyword"
    done
  fi

  note_name="${note_name}.${note_ext}"
  touch "$note_name"
  edit_note "$note_name"
}

remove_note() {
  local note=""

  note="$(select_note "$@")" || return $?
  rm -i -- "$note"
}

usage() {
  cat <<EOF
A command line note taking utility.

Usage:
  $basename_cmd new|n <name>      Create a new note
  $basename_cmd vim <name>        Open an existing note
  $basename_cmd ls <options>      List notes with ls options
  $basename_cmd open|o            Open the notes directory
  $basename_cmd rm                Remove a note
EOF
}

main() {
  local command="${1:-}"

  ensure_notes_dir
  (($# > 0)) && shift

  case "$command" in
    new | n) new_note "$@" ;;
    nvim | vim | vi | v) edit_note "$@" ;;
    ls) list_notes "$@" ;;
    open | o) open_note_dir ;;
    rm) remove_note "$@" ;;
    *)
      usage
      return 1
      ;;
  esac
}

main "$@"
